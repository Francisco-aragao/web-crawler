4-A\":7086080,\"iPad8,11\":7086080,\"universal\":8138752,\"iPad7,5\":7086080,\"iPad13,19\":7086080,\"iPhone14,6\":7086080,\"iPhone11,2\":7086080,\"iPad8,8\":7086080,\"iPad7,3\":7086080,\"iPhone14,3\":7086080,\"iPhone14,7\":7086080,\"iPad13,11\":7086080,\"iPhone15,2\":7086080,\"iPad14,2\":7086080,\"iPad8,1\":7086080,\"iPad14,5-B\":7086080,\"MacFamily20,1\":7086080,\"iPad13,7\":7086080,\"iPhone13,4\":7086080,\"iPhone12,5\":7086080,\"iPad14,5-A\":7086080,\"iPhone15,5\":7086080,\"iPad11,1\":7086080,\"iPad14,6-B\":7086080,\"iPad13,4\":7086080,\"iPad8,4\":7086080,\"iPad13,6\":7086080}},\"relationships\":{\"app-events\":{\"href\":\"/v1/catalog/br/apps/6477896543/app-events?l=pt-BR\",\"data\":[]},\"reviews\":{\"href\":\"/v1/catalog/br/apps/6477896543/reviews?l=pt-BR\",\"data\":[]},\"top-in-apps\":{\"href\":\"/v1/catalog/br/apps/6477896543/top-in-apps?l=pt-BR\",\"data\":[{\"id\":\"6478886834\",\"type\":\"in-apps\",\"href\":\"/v1/catalog/br/in-apps/6478886834?l=pt-BR\",\"attributes\":{\"offers\":[{\"buyParams\":\"productType=A\u0026price=24900\u0026salableAdamId=6478886834\u0026pricingParameters=STDQ\u0026pg=phoenix\u0026offerName=PostCardTip1x3\u0026appAdamId=6477896543\",\"type\":\"buy\",\"priceFormatted\":\"R$Â 24,90\",\"price\":24.9,\"priceString\":\"24.90\",\"currencyCode\":\"BRL\",\"assets\":[]}],\"isSubscription\":false,\"isMerchandisedVisibleByDefault\":false,\"offerName\":\"PostCardTip1x3\",\"isFamilyShareable\":false,\"releaseDate\":\"2009-06-17\",\"editorialArtwork\":{},\"isMerchandisedEnabled\":false,\"name\":\"Tip for new postcards\",\"description\":{\"standard\":\"Contribution to new postcards \"},\"icuLocale\":\"pt_BR@currency=BRL\",\"url\":\"https://apps.apple.com/br/app/tip-for-new-postcards/id6477896543\"}},{\"id\":\"6478886622\",\"type\":\"in-apps\",\"href\":\"/v1/catalog/br/in-apps/6478886622?l=pt-BR\",\"attributes\":{\"offers\":[{\"buyParams\":\"productType=A\u0026price=14900\u0026salableAdamId=6478886622\u0026pricingParameters=STDQ\u0026pg=phoenix\u0026offerName=RemoveAds13\u0026appAdamId=6477896543\",\"type\":\"buy\",\"priceFormatted\":\"R$Â 14,90\",\"price\":14.9,\"priceString\":\"14.90\",\"currencyCode\":\"BRL\",\"assets\":[]}],\"isSubscription\":false,\"isMerchandisedVisibleByDefault\":false,\"offerName\":\"RemoveAds13\",\"isFamilyShareable\":false,\"releaseDate\":\"2009-06-17\",\"editorialArtwork\":{},\"isMerchandisedEnabled\":false,\"name\":\"Remove all Ads\",\"description\":{\"standard\":\"Remove the in-app advertising \"},\"icuLocale\":\"pt_BR@currency=BRL\",\"url\":\"https://apps.apple.com/br/app/remove-all-ads/id6477896543\"}}]},\"developer-other-apps\":{\"href\":\"/v1/catalog/br/apps/6477896543/developer-other-apps?l=pt-BR\",\"data\":[{\"id\":\"1209200428\",\"type\":\"apps\",\"href\":\"/v1/catalog/br/apps/1209200428?l=pt-BR\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Dados nÃ£o coletados\",\"identifier\":\"DATA_NOT_COLLECTED\",\"description\":\"Os desenvolvedores nÃ£o coletam nenhum dado deste app.\",\"dataCategories\":[]}]},\"contentRatingsBySystem\":{\"appsBrazil\":{\"name\":\"Brazil L\",\"value\":100,\"rank\":6},\"appsApple\":{\"name\":\"+4\",\"value\":100,\"rank\":1}},\"deviceFamilies\":[\"watch\",\"iphone\",\"ipad\"],\"supportsStreamlinedBuy\":true,\"url\":\"https://apps.apple.com/br/app/pods-podcast-player/id1209200428\",\"userRating\":{\"value\":4.1,\"ratingCount\":14,\"ratingCountList\":[2,0,2,1,9],\"ariaLabelForRatings\":\"4.1 estrelas\"},\"firstVersionSupportingInAppPurchaseApi\":\"5.3\",\"watchBundleId\":\"com.app.Pods.watchkitapp\",\"name\":\"Pods- Podcast Player\",\"genreDisplayName\":\"NotÃ­cias\",\"isPreorder\":false,\"isIOSBinaryMacOSCompatible\":false,\"artistName\":\"Miguel Krantz\",\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"watch\":{\"deviceFamily\":\"AppleÂ Watch\",\"requirementString\":\"Requer o watchOSÂ 9.4 ou posterior.\"},\"ipad\":{\"deviceFamily\":\"iPad\",\"requirementString\":\"Requer o iPadOSÂ 17.0 ou posterior.\"},\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requer o iOSÂ 17.0 ou posterior.\"},\"realityDevice\":{\"deviceFamily\":\"Apple Vision\",\"requirementString\":\"Requer o visionOSÂ 1.0 ou posterior.\"}},\"minimumWatchOSVersion\":\"9.4\",\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"14.0\",\"description\":{\"standard\":\"\\nUnlock the door to a world of audio excellence. Download our iOS podcast player app with its user-friendly interface, and let your auditory journey begin. With every episode, including riveting true crime investigations, you'll redefine the way you listen, learn, and live.\\n\\nFind peace and harmony with the new Zen Player, your ultimate companion for relaxation and meditation. Explore a world of soothing sounds with various themes to help you find tranquility in your daily life.\\n\\n* Versatile Sound Themes: Discover a diversity of soothing sound themes including piano music, birdsong, and natural sounds. Each theme is carefully crafted to create an atmosphere of peace and relaxation.\\n* Scheduled Sessions: Set time limits for playback \\n\\n*** FEATURES ***:\\n- Easy access to trueCrime stories\\n-  Silence Trimmer and Smart Speed: Say goodbye to long silences with this smart feature that snips out breath-length gaps.\\n-  Custom Playlists and Sharing: Create and share playlists, mixing podcasts and episodes, and even configure images to share with friends and fellow Pods listeners.\\n-  Chapter Navigation: Seamlessly navigate between chapters, if supported by the podcast.\\n-  Subscription and Play: Subscribe to podcasts or simply add and play episodes.\\n-  Airplay: Send episodes straight to your TV or speakers with a single tap.\\n-  Offline Listening: Download podcast episodes to enjoy anytime, anywhere.\\n-  Episode Notifications: Receive optional notifications when new episodes arrive.\\n-  Sleep Timer: Drift off to your favorite podcasts with a sleep timer.\\n-  Cross-device Support: Enjoy Pods on both your iPad and iPhone.\\n-  Multilingual Support: Change the app's language.\\n-  Region-specific Content: Select from over 30+ regions for podcast content.\\n-  Search and Recommendations: Discover new podcasts and get personalized recommendations.\\n-  Import and Private URLs: Import podcasts from other players and add private podcast URLs.\\n-  Enhanced Control: Utilize 3D Touch support and control the player from headphones and Bluetooth devices.\\n-  Dynamic Links: Share and open podcasts using dynamic links.\\n-  Video Streaming: Stream podcast videos for a multimedia experience.\\n-  Playback Speeds: Play podcasts at different speeds: 1/2x, 1x, and 2x.\\n\\n\\n*** DISCOVERY ***:\\n-Podcast-Linked Articles: Access relevant articles linked to your podcasts.\\n-Episode Length Filters: Display sections by length: 30min, 60min, 90min, and 120min.\\n-Top List and Categories: Explore the Swedish podcast top list and 16 categories, including Music, Video Games, News \u0026 Politics, Business, Art, Education, Comedy, and more.\\n\\n*** SEARCH ***:\\n- Section Length and Title Search: Search by section length (15, 30, 60, 120min) or podcast title.\\n- Quick Local Filters: Swiftly filter popular podcasts locally.\\n- Trending Podcasts: Discover trending podcasts.\\n- Search Results Filter: Filter search results based on podcasts and sections.\\n\\n*** PODCAST ***:\\n- Select the shows you want to receive push notifications for\\n- Detailed Information: Read more about the podcast online.\\n- Subscribe and Notifications: Subscribe and receive notifications for new episodes.\\n- Share QR Code: Share the podcast's QR code.\\n- Play and Navigate Sections: Play and navigate through sections.\\n- Episode Sharing: Share podcast episodes with friends.\\n- New Section Alerts: Get notified when new sections are available.\\n- Time Left Display: See the time left for ongoing episodes.\\n\\n*** PLAYLIST ***:\\n- Custom Sorting: Organize your playlist as you like.\\n- Save and Download: Save (+) sections for later and download episodes for offline listening.\\n- Section Details: Read more about specific sections.\\n- Bare Downloads: Access your downloaded episodes easily.\\n\\nPrivacy Policy:\\n[Privacy Policy](https://www.pods.one/Privacy/privacy-doc-eng.html)\\n\\nTerms of Use:\\n[Terms of Use](https://www.apple.com/legal/internet-services/itunes/dev/stdeula/)\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":true,\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"websiteUrl\":\"https://www.pods.one\",\"versionHistory\":[{\"versionDisplay\":\"17.8\",\"releaseNotes\":\"Bug fixes and performance improvements\\nWe are constantly making changes and improvements to Pods. Make sure you enable updates so you do not miss anything.\\n\\nIf you have comments, questions or ideas, please contact us at podsplayer@gmail.com. Thank you for using Pods!\\n\\n/ Pods- Team\",\"releaseDate\":\"2025-01-14\",\"releaseTimestamp\":\"2025-01-14T10:07:33Z\"},{\"versionDisplay\":\"17.7\",\"releaseNotes\":\"improved performance and some bug fixes\",\"releaseDate\":\"2024-04-21\",\"releaseTimestamp\":\"2024-04-21T11:08:52Z\"},{\"versionDisplay\":\"17.6\",\"releaseNotes\":\"Bug fixes and performance improvements\\nWe are constantly making changes and improvements to Pods. Make sure you enable updates so you do not miss anything.\\n\\nIf you have comments, questions or ideas, please contact us at podsplayer@gmail.com. Thank you for using Pods!\",\"releaseDate\":\"2024-04-07\",\"releaseTimestamp\":\"2024-04-07T19:09:12Z\"},{\"versionDisplay\":\"17.5\",\"releaseNotes\":\"Bug fixes and performance improvements\\nWe are constantly making changes and improvements to Pods. Make sure you enable updates so you do not miss anything.\\n\\nIf you have comments, questions or ideas, please contact us at podsplayer@gmail.com. Thank you for using Pods!\",\"releaseDate\":\"2024-03-27\",\"releaseTimestamp\":\"2024-03-27T23:18:57Z\"},{\"versionDisplay\":\"17.4\",\"releaseNotes\":\"Bug fixes and performance improvements\\nWe are constantly making changes and improvements to Pods. Make sure you enable updates so you do not miss anything.\\n\\nIf you have comments, questions or ideas, please contact us at podsplayer@gmail.com. Thank you for using Pods!\\n\\n/ Pods- Team\",\"releaseDate\":\"2024-01-20\",\"releaseTimestamp\":\"2024-01-20T13:30:41Z\"},{\"versionDisplay\":\"17.3\",\"releaseNotes\":\"Bug fixes and performance improvements\\nWe are constantly making changes and improvements to Pods. Make sure you enable updates so you do not miss anything.\\n\\nIf you have comments, questions or ideas, please contact us at podsplayer@gmail.com. Thank you for using Pods!\\n\\n/ Pods- Team\\n\",\"releaseDate\":\"2024-01-12\",\"releaseTimestamp\":\"2024-01-12T00:26:13Z\"},{\"versionDisplay\":\"17.2\",\"releaseNotes\":\"Bug fixes and performance improvements\\nWe are constantly making changes and improvements to Pods. Make sure you enable updates so you do not miss anything.\\n\\nIf you have comments, questions or ideas, please contact us at podsplayer@gmail.com. Thank you for using Pods!\\n\\n/ Pods- Team\",\"releaseDate\":\"2023-12-27\",\"releaseTimestamp\":\"2023-12-27T19:28:05Z\"},{\"versionDisplay\":\"17.0\",\"releaseNotes\":\"Bug fixes and enhancements\\nThanks! for using and sharing Pods :)\\nMissing any feature? or have improvements suggestions please mail \\npodsplayer@gmail.com\",\"releaseDate\":\"2023-12-18\",\"releaseTimestamp\":\"2023-12-18T12:57:29Z\"},{\"versionDisplay\":\"16.9.1\",\"releaseNotes\":\"Version Number: 16.9.1 \\\"Sovgod Improvement\\\"\\nWhat is new?\\n* Sovgod mode: Now with improved sound quality and no surprising quiet moments to keep you up at night!\\n* Stability fixes: We've given the Zen player a calmer and more harmonious sleep, making it more stable and reliable than ever before.\\nA big thank you to my amazing wife for helping us discover and fix this unexpected \\\"wake-by-sound\\\" problem! Her passion for sleep has helped us create an app that is ready to give you dreamlike audio experiences.\",\"releaseDate\":\"2023-12-13\",\"releaseTimestamp\":\"2023-12-13T07:16:53Z\"},{\"versionDisplay\":\"16.9\",\"releaseNotes\":\"Bug fixes and performance improvements\\nWe are constantly making changes and improvements to Pods. Make sure you enable updates so you do not miss anything.\\n\\nIf you have comments, questions or ideas, please contact us at podsplayer@gmail.com. Thank you for using Pods!\\n\\n/ Pods- Team\\n\\nUpdate now to enjoy the latest improvements and bug fixes. We value your feedback, so if you have any suggestions or encounter any issues, please reach out to our support team. Thank you for using our app!\\npodsplayer@gmail.com\\n\",\"releaseDate\":\"2023-12-12\",\"releaseTimestamp\":\"2023-12-12T01:56:59Z\"},{\"versionDisplay\":\"16.8\",\"releaseNotes\":\"Bug Squashing Extravaganza: \\nHowdy, Podcast Pioneers!\\nWe're zapping pesky bugs faster than a superhero with a fly swatter. Version 16.8 is a bug-fix bonanza, making your podcast experience smoother than a buttered slide!\\n\\nIf you have comments, questions or ideas, please contact us at podsplayer@gmail.com. Thank you for using Pods!\\n\\n/PodCast-Team + ChatGPT\",\"releaseDate\":\"2023-12-01\",\"releaseTimestamp\":\"2023-12-01T17:49:19Z\"},{\"versionDisplay\":\"16.7\",\"releaseNotes\":\"Discover serenity with ZenPlayer. Immerse yourself in tranquil melodies like piano, birdsong, and nature's symphony. Set timed sessions for tailored relaxation or bedtime bliss. Find your peace within\\n\\nBug fixes and performance improvements\\nWe are constantly making changes and improvements to Pods. Make sure you enable updates so you do not miss anything.\\n\\nIf you have comments, questions or ideas, please contact us at podsplayer@gmail.com. Thank you for using Pods!\\n\\n/ Pods- Team\",\"releaseDate\":\"2023-11-28\",\"releaseTimestamp\":\"2023-11-28T07:26:12Z\"},{\"versionDisplay\":\"16.6\",\"releaseNotes\":\"Bug fixes and performance improvements\\nWe are constantly making changes and improvements to Pods. Make sure you enable updates so you do not miss anything.\\n\\nIf you have comments, questions or ideas, please contact us at podsplayer@gmail.com. Thank you for using Pods!\\n\\n/ Pods- Team\\n\",\"releaseDate\":\"2023-11-13\",\"releaseTimestamp\":\"2023-11-13T10:02:07Z\"},{\"versionDisplay\":\"16.5\",\"releaseNotes\":\"We are constantly making changes and improvements to Pods. Make sure you enable updates so you do not miss anything.\\n\\nIf you have comments, questions or ideas, please contact us at podsplayer@gmail.com. Thank you for using Pods!\\n\\n/ Pods- Team\\n\",\"releaseDate\":\"2023-10-18\",\"releaseTimestamp\":\"2023-10-18T22:42:06Z\"},{\"versionDisplay\":\"16.4\",\"releaseNotes\":\"Bug fixes and performance improvements\\nWe are constantly making changes and improvements to Pods. Make sure you enable updates so you do not miss anything.\\n\\nIf you have comments, questions or ideas, please contact us at podsplayer@gmail.com. Thank you for using Pods!\\n\\n/ Pods- Team\\n\\nUpdate now to enjoy the latest improvements and bug fixes. We value your feedback, so if you have any suggestions or encounter any issues, please reach out to our support team. Thank you for using our app!\\npodsplayer@gmail.com\",\"releaseDate\":\"2023-10-10\",\"releaseTimestamp\":\"2023-10-10T09:42:18Z\"},{\"versionDisplay\":\"16.3\",\"releaseNotes\":\"Bug fixes and enhancements\\nThanks! for using and sharing Pods :)\\nMissing any feature? or have improvements suggestions please mail \\npodsplayer@gmail.com\",\"releaseDate\":\"2023-10-01\",\"releaseTimestamp\":\"2023-10-01T18:19:59Z\"},{\"versionDisplay\":\"16.2\",\"releaseNotes\":\"Bug fixes and enhancements\\nThanks! for using and sharing Pods :)\\nMissing any feature? or have improvements suggestions please mail \\npodsplayer@gmail.com\",\"releaseDate