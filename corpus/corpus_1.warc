NTENT\"},{\"dataCategory\":\"HistÃ³rico de buscas\",\"identifier\":\"SEARCH_HISTORY\"},{\"dataCategory\":\"IdentificadoÂ­res\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"InformaÃ§Ãµes de uso\",\"identifier\":\"USAGE_DATA\"},{\"dataCategory\":\"DiagnÃ³stico\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsBrazil\":{\"name\":\"Brazil 18\",\"value\":600,\"rank\":11,\"advisories\":[\"ReferÃªncias infrequentes/moderadas a Ã¡lcool, tabaco ou drogas\",\"ConteÃºdo sexual e nudez infrequente/moderado\",\"ViolÃªncia infrequente/moderada em desenhos animados e fantasia\",\"ViolÃªncia realista infrequente/moderada\",\"Temas adultos/sugestivos infrequentes/moderados\",\"InformaÃ§Ã£o mÃ©dica/tratamento infrequente/moderada\",\"Temas de terror/medo infrequentes/moderados\",\"Uso infrequente/moderado de obscenidades ou humor grosseiro\"]},\"appsApple\":{\"name\":\"+17\",\"value\":600,\"rank\":4,\"advisories\":[\"ReferÃªncias infrequentes/moderadas a Ã¡lcool, tabaco ou drogas\",\"ConteÃºdo sexual e nudez infrequente/moderado\",\"ViolÃªncia infrequente/moderada em desenhos animados e fantasia\",\"ViolÃªncia realista infrequente/moderada\",\"Temas adultos/sugestivos infrequentes/moderados\",\"InformaÃ§Ã£o mÃ©dica/tratamento infrequente/moderada\",\"Temas de terror/medo infrequentes/moderados\",\"Uso infrequente/moderado de obscenidades ou humor grosseiro\"]}},\"deviceFamilies\":[\"iphone\",\"ipad\",\"ipod\"],\"supportsStreamlinedBuy\":true,\"url\":\"https://apps.apple.com/br/app/breaker-the-social-podcast-app/id1215095006\",\"userRating\":{\"value\":4.7,\"ratingCount\":51,\"ratingCountList\":[1,0,2,5,43],\"ariaLabelForRatings\":\"4.7 estrelas\"},\"firstVersionSupportingInAppPurchaseApi\":\"1.2.0\",\"name\":\"BreakerâThe social podcast app\",\"genreDisplayName\":\"NotÃ­cias\",\"isPreorder\":false,\"isIOSBinaryMacOSCompatible\":true,\"artistName\":\"Maple Media Apps, LLC\",\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"ipod\":{\"deviceFamily\":\"iPodÂ touch\",\"requirementString\":\"Requer o iOSÂ 13.0 ou posterior.\"},\"ipad\":{\"deviceFamily\":\"iPad\",\"requirementString\":\"Requer o iPadOSÂ 13.0 ou posterior.\"},\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requer o iOSÂ 13.0 ou posterior.\"},\"mac\":{\"deviceFamily\":\"Mac\",\"requirementString\":\"Requer o macOSÂ 11.0 ou posterior e um Mac com o chip M1 da Apple ou posterior.\"},\"realityDevice\":{\"deviceFamily\":\"Apple Vision\",\"requirementString\":\"Requer o visionOSÂ 1.0 ou posterior.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"New to podcasts? Looking for trending content recommendations? Or do you listen every day?\\nEither way, you can find all your favorite podcast shows and episodes on Breaker! With over 20 million podcasts available \u0026 growing day by day!\\n\\nDownload Breaker today and discover a fresh podcast experience, combining your favorite shows with powerful features to optimize your listening experience. \\n \\nElevate your Listening Experience: \\n\\n- Subscribe to shows you love\\n- Easily search and find new shows\\n- Download new episodes automatically\\n- Get customized podcast recommendations\\n- Cloud sync show playback across your iPhone and iPad\\n- Offline mode (wifi not required)\\n- Dark mode and colorful themes \\n- Playback speed controls\\n- Sleep timer so you can fall asleep to a show \\n- Audiobooks, video podcasts and more \\n- Human curated suggestions updated every day\\n- Listening stats to track how many shows you listen to \\n \\nSubscribe to Breaker+: \\n\\nâ¢ Space Saver: Compress downloaded episodes, while maintaining audio quality. A 100MB MP3 could compress to 30MB\\nâ¢ Relax \u0026 Sleep: Discover and listen to relaxing sleep sounds hand-picked by our editors.\\nâ¢ Custom App Icons: Choose from 9 unique app icons to match your home screen.\\nâ¢ iPad support: Explore the app in Portrait and Landscape views.\\nâ¢ Apple Watch support: Access playback controls right from your wrist. \\nâ¢ Ad-Free experience: Focus on the content of your favorite podcast episodes without the distraction of ads.\\nâ¢ Play on Multiple Devices: Easily sync playlists, full play history, and resume playback across devices.\\nâ¢ Playlists \u0026 Bookmarks: Create playlists \u0026 time stamped bookmarks, synced to your cloud account.\\nâ¢ Theme Editor: Unlock all premium themes, cloud-sync your custom themes across all your devices.\\nâ¢ Turbo Fetch: Be the first to know when a new episode drops. \\nâ¢ Personal Search: Locate any episode with ease, right from your subscriptions \u0026 playlists.\\n \\n______________\\n \\nSubscription Info\\n\\nFor podcast subscriptions, payment will be charged to your iTunes Account at confirmation of purchase. The subscription will automatically renew monthly. Your account will be charged for renewal within 24-hours prior to the end of the current period. The subscription will automatically renew unless turned off at least 24-hours prior to the end of the current monthly period. Subscription may be managed, and auto-renewal may be turned off, by going to your App Store Account Settings after purchase.\\n \\nPrivacy policy: https://maplemedia.io/privacy/\\nTerms of service: https://maplemedia.io/terms-of-service/\\n \\nQuestions? Feedback? Email us at contact@maplemedia.io\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"websiteUrl\":\"https://maplemedia.io\",\"versionHistory\":[{\"versionDisplay\":\"5.1.6\",\"releaseNotes\":\"Hey, friends, listen up! Your favorite podcasting app has been totally redesigned to improve and add features that listeners like you love the most. Donât worry, your subscriptions havenât gone anywhere, just login and youâll find your shows right where you left them. So, sit back \u0026 tune in to a whole new chapter with Breaker. \\r\\n\\r\\nEnjoy the new Transcripts feature!\\r\\n\\r\\n\\r\\n\\r\\nAre you a super listener? Subscribe to Breaker+ for more advanced listening features, plus unlock a personalized podcasting experience unlike any other\",\"releaseDate\":\"2024-11-13\",\"releaseTimestamp\":\"2024-11-13T21:35:17Z\"},{\"versionDisplay\":\"5.1.5\",\"releaseNotes\":\"Hey, friends, listen up! Your favorite podcasting app has been totally redesigned to improve and add features that listeners like you love the most. Donât worry, your subscriptions havenât gone anywhere, just login and youâll find your shows right where you left them. So, sit back \u0026 tune in to a whole new chapter with Breaker. \\n\\nEnjoy the new Transcripts feature!\\n\\n\\r\\n\\r\\nAre you a super listener? Subscribe to Breaker+ for more advanced listening features, plus unlock a personalized podcasting experience unlike any other\",\"releaseDate\":\"2024-06-12\",\"releaseTimestamp\":\"2024-06-12T20:58:32Z\"},{\"versionDisplay\":\"5.0.28\",\"releaseNotes\":\"Hey, friends, listen up! Your favorite podcasting app has been totally redesigned to improve and add features that listeners like you love the most. Donât worry, your subscriptions havenât gone anywhere, just login and youâll find your shows right where you left them. So, sit back \u0026 tune in to a whole new chapter with Breaker. \\r\\n\\r\\nAre you a super listener? Subscribe to Breaker+ for more advanced listening features, plus unlock a personalized podcasting experience unlike any other. \\r\\n\",\"releaseDate\":\"2023-10-20\",\"releaseTimestamp\":\"2023-10-20T00:10:05Z\"},{\"versionDisplay\":\"5.0.27\",\"releaseNotes\":\"Hey, friends, listen up! Your favorite podcasting app has been totally redesigned to improve and add features that listeners like you love the most. Donât worry, your subscriptions havenât gone anywhere, just login and youâll find your shows right where you left them. So, sit back \u0026 tune in to a whole new chapter with Breaker. \\r\\n\\r\\nAre you a super listener? Subscribe to Breaker+ for more advanced listening features, plus unlock a personalized podcasting experience unlike any other. \\r\\n\\r\\n\",\"releaseDate\":\"2023-07-04\",\"releaseTimestamp\":\"2023-07-04T00:47:07Z\"},{\"versionDisplay\":\"5.0.26\",\"releaseNotes\":\"Hey, friends, listen up! Your favorite podcasting app has been totally redesigned to improve and add features that listeners like you love the most. Donât worry, your subscriptions havenât gone anywhere, just login and youâll find your shows right where you left them. So, sit back \u0026 tune in to a whole new chapter with Breaker. \\r\\n\\r\\nAre you a super listener? Subscribe to Breaker+ for more advanced listening features, plus unlock a personalized podcasting experience unlike any other. \\r\\n\",\"releaseDate\":\"2023-06-21\",\"releaseTimestamp\":\"2023-06-21T16:47:06Z\"},{\"versionDisplay\":\"5.0.20\",\"releaseNotes\":\"Hey, friends, listen up! Your favorite podcasting app has been totally redesigned to improve and add features that listeners like you love the most. Donât worry, your subscriptions havenât gone anywhere, just login and youâll find your shows right where you left them. So, sit back \u0026 tune in to a whole new chapter with Breaker. \\n\\nAre you a super listener? Subscribe to Breaker+ for more advanced listening features, plus unlock a personalized podcasting experience unlike any other. \",\"releaseDate\":\"2021-12-18\",\"releaseTimestamp\":\"2021-12-18T01:50:12Z\"},{\"versionDisplay\":\"1.2.10\",\"releaseNotes\":\"Thank you for updating to the latest version of Breaker! Hereâs whatâs new in this release:\\n\\n- Introducing a new way to support your favorite podcast app with Breaker+. Subscribe to Breaker+ for more advanced listening features, plus unlock a social podcasting experience unlike any other!\\n\\n- Discovered a few pesky bugs and squashed them on the spot! \\n\\n- Resolved login issues for users who reported problems accessing their account.\\n\\n- Significant optimizations to the backend codebase which adds long term benefits.\\n\\n- Fine-tuned the User Interface to improve overall usability.\\n\\nSpecial thanks to the Breaker community for staying tuned in; weâre excited to continue expanding this awesome podcasting service!\",\"releaseDate\":\"2021-05-11\",\"releaseTimestamp\":\"2021-05-11T04:17:11Z\"},{\"versionDisplay\":\"1.2.9\",\"releaseNotes\":\"Thank you for updating to the latest version of Breaker! Hereâs whatâs new in this release:\\n\\n- Introducing a new way to support your favorite podcast app with Breaker+. Subscribe to Breaker+ for more advanced listening features, plus unlock a social podcasting experience unlike any other!\\n\\n- Discovered a few pesky bugs and squashed them on the spot! \\n\\n- Resolved login issues for users who reported problems accessing their account.\\n\\n- Significant optimizations to the backend codebase which adds long term benefits.\\n\\n- Fine-tuned the User Interface to improve overall usability.\\n\\nSpecial thanks to the Breaker community for staying tuned in; weâre excited to continue expanding this awesome podcasting service!\",\"releaseDate\":\"2021-02-12\",\"releaseTimestamp\":\"2021-02-12T05:35:03Z\"},{\"versionDisplay\":\"1.2.0\",\"releaseNotes\":\"Thank you for updating to the latest version of Breaker! Hereâs whatâs new in this release:\\r\\n\\n- Introducing a new way to support your favorite podcast app with Breaker+. Subscribe to Breaker+ for more advanced listening features, plus unlock a social podcasting experience unlike any other!\\r\\n\\n- Discovered a few pesky bugs and squashed them on the spot! \\r\\n\\n- Resolved login issues for users who reported problems accessing their account.\\r\\n\\n- Significant optimizations to the backend codebase which adds long term benefits.\\r\\n\\n- Fine-tuned the User Interface to improve overall usability.\\r\\n\\nSpecial thanks to the Breaker community for staying tuned in; weâre excited to continue expanding this awesome podcasting service!\",\"releaseDate\":\"2021-02-05\",\"releaseTimestamp\":\"2021-02-05T18:46:17Z\"},{\"versionDisplay\":\"1.1.12\",\"releaseNotes\":\"- Titles when long-pressing the back button in iOS 14\\n- Fix for episode likes count color\\n- Fix for show subscribers count color\",\"releaseDate\":\"2020-11-08\",\"releaseTimestamp\":\"2020-11-08T15:03:52Z\"},{\"versionDisplay\":\"1.1.11\",\"releaseNotes\":\"Fixes for tapping scrolling views in the Home tab (thanks Aleksandra).\",\"releaseDate\":\"2020-10-13\",\"releaseTimestamp\":\"2020-10-13T17:16:24Z\"},{\"versionDisplay\":\"1.1.10\",\"releaseNotes\":\"Fix for white bars in show episodes in dark mode.\",\"releaseDate\":\"2020-10-05\",\"releaseTimestamp\":\"2020-10-05T15:11:55Z\"},{\"versionDisplay\":\"1.1.9\",\"releaseNotes\":\"âFix for white bars next to buttons in a playlist in dark mode.\",\"releaseDate\":\"2020-09-23\",\"releaseTimestamp\":\"2020-09-23T17:54:09Z\"},{\"versionDisplay\":\"1.1.8\",\"releaseNotes\":\"- Updated to XCode 12\\n- Updated third party libraries\\n- Fixed progress conversion to a time range\",\"releaseDate\":\"2020-09-19\",\"releaseTimestamp\":\"2020-09-19T15:03:18Z\"},{\"versionDisplay\":\"1.1.7\",\"releaseNotes\":\"- Fix for paginating subscriptions grid (thanks Shweta T)\\n- Fix for removing in-progress episodes after listening\",\"releaseDate\":\"2020-08-06\",\"releaseTimestamp\":\"2020-08-06T19:36:05Z\"},{\"versionDisplay\":\"1.1.6\",\"releaseNotes\":\"Bug fixes!\\nââ- Fix for pages of podcast episodes (thanks Denis and Rae)\\n- ââFix for tapping push notification to view an episode\\nââ- Updates for 3rd party libraries\",\"releaseDate\":\"2020-07-14\",\"releaseTimestamp\":\"2020-07-14T19:19:14Z\"},{\"versionDisplay\":\"1.1.5\",\"releaseNotes\":\"- Performance improvements for CarPlay, episodes, comments, and lists of subscriptions and user credits\\n- Message to user when importing a new podcast (thanks Chris M)\\n- Fix for pausing/playing episode on episode screen\\n- Episodes remain in-progress until 10 seconds from the end\\n- Fix for previous episode audio playing while displaying new episode\",\"releaseDate\":\"2020-07-06\",\"releaseTimestamp\":\"2020-07-06T22:38:21Z\"},{\"versionDisplay\":\"1.1.4\",\"releaseNotes\":\"- Fix for subscribers unlimited list (thanks Dave C)\\n- Fix for episode description HTML turning wrong colors/theme\\n- Ability to remove an episode or show from a playlist in the âadd to playlistâ screen\\n- Performance improvements for lists of followers, listened episodes, liked episodes, user comments, and podcast credits\\n- Fix for cancelling downloads when logging out\",\"releaseDate\":\"2020-06-26\",\"releaseTimestamp\":\"2020-06-26T18:27:27Z\"},{\"versionDisplay\":\"1.1.3\",\"releaseNotes\":\"- Image caching fixes\\n- Performance improvements for loading Playlists and Subscriptions tabs\\n- Bug fix for refreshing episodes\\n- Fix so that logged-out user cannot pull-to-refresh Playlists or Subscriptions\",\"releaseDate\":\"2020-06-17\",\"releaseTimestamp\":\"2020-06-17T18:29:23Z\"},{\"versionDisplay\":\"1.1.2\",\"releaseNotes\":\"- New #BlackLivesMatter app icon option.\\n- Performance improvements for faster loading of podcast episodes and user profiles.\",\"releaseDate\":\"2020-06-05\",\"releaseTimestamp\":\"2020-06-05T20:51:54Z\"},{\"versionDisplay\":\"1.1.1\",\"releaseNotes\":\"- Updated Alamofire to 5.1.0 (thanks Jon S)\\n- Fixed profile screen constraint issue\\n- Fixed playback rate view tint colors\",\"releaseDate\":\"2020-05-19\",\"releaseTimestamp\":\"2020-05-19T19:11:42Z\"},{\"versionDisplay\":\"1.1.0\",\"releaseNotes\":\"Updated audio player and improved performance.\\n\\n- Added ability to toggle the unlistened episode sort order\\n- Larger tap target for player slider (thanks Paul S)\\n- Fixes for player layout on smaller devices (thanks Setu U)\\n- Removed scroll bars from player view\\n- Sorted downloads by newest first\\n- Fix for removing listened episodes from a playlist\",\"releaseDate\":\"2020-04-27\",\"releaseTimestamp\":\"2020-04-27T20:57:01Z\"},{\"versionDisplay\":\"1.0.8\",\"releaseNotes\":\"- Fix to update theme for expanded descriptions (thanks Chris M)\\n- Added a setting to delete your own account\\n- Debugging for app crashes\\n- Fix to not display the delete button for othersâ playlists\",\"releaseDate\":\"2020-04-13\",\"releaseTimestamp\":\"2020-04-13T16:09:22Z\"},{\"versionDisplay\":\"1.0.7\",\"releaseNotes\":\"New! Change your app icon. Now you can choose from several past Breaker icons, including Sunrise, Rainbow, and our original Beta icon.\\n\\nMore updates:\\n- Fix for shareable playlist ânewâ label\\n- Fix for playlist updating\\n- Fix for Home tab refreshing spinner\",\"releaseDate\":\"2020-04-01\",\"releaseTimestamp\":\"2020-04-01T23:21:50Z\"},{\"versionDisplay\":\"1.0.6\",\"releaseNotes\":\"- Improved internal view updating\\n- Additional logging for audio errors\\n- Improved security for Sign in with Apple\\n- Unlistened sorted with newest first (thanks Edward M)\\n- Updated sleep timer label for end of episode\\n- Fix for import text in dark mode\\n- Updated import instructions from Castro app\\n- Fix for âLogging inâ¦â text color\",\"releaseDate\":\"2020-03-27\",\"releaseTimestamp\":\"2020-03-27T17:00:23Z\"}],\"isXROSCompatible\":true,\"minimumXROSVersion\":\"1.0\",\"hasSafariExtension\":false,\"messagesScreenshots\":{},\"requiresGameController\":false,\"offers\":[{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1215095006\u0026pricingParameters=STDQ\u0026pg=phoenix\u0026appExtVrsId=870405230\",\"type\":\"get\",\"priceFormatted\":\"R$Â 0,00\",\"price\":0,\"priceString\":\"0.00\",\"currencyCode\":\"BRL\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":194830336}]},{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1215095006\u0026pricingParameters=SWUPD\u0026pg=phoenix\u0026appExtVrsId=870405230\",\"type\":\"upd