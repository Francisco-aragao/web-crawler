":[]}],\"isSubscription\":false,\"isMerchandisedVisibleByDefault\":false,\"offerName\":\"ICATCHER_TIP_01\",\"isFamilyShareable\":false,\"releaseDate\":\"2009-06-17\",\"editorialArtwork\":{},\"isMerchandisedEnabled\":false,\"name\":\"Thank You Tip\",\"description\":{\"standard\":\"A way to say thanks for the continued work and enhancements to the app.\"},\"icuLocale\":\"pt_BR@currency=BRL\",\"url\":\"https://apps.apple.com/br/app/thank-you-tip/id414419105\"}}]},\"developer-other-apps\":{\"href\":\"/v1/catalog/br/apps/414419105/developer-other-apps?l=pt-BR\",\"data\":[]},\"related-editorial-items\":{\"href\":\"/v1/catalog/br/apps/414419105/related-editorial-items?l=pt-BR\",\"data\":[]},\"customers-also-bought-apps\":{\"href\":\"/v1/catalog/br/apps/414419105/customers-also-bought-apps?l=pt-BR\",\"next\":\"/v1/catalog/br/apps/414419105/customers-also-bought-apps?l=pt-BR\u0026offset=10\",\"data\":[{\"id\":\"393858566\",\"type\":\"apps\",\"href\":\"/v1/catalog/br/apps/393858566?l=pt-BR\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Dados nÃ£o vinculados a vocÃª\",\"identifier\":\"DATA_NOT_LINKED_TO_YOU\",\"description\":\"Os seguintes dados podem ser coletados, mas nÃ£o estÃ£o vinculados Ã  sua identidade:\",\"dataCategories\":[{\"dataCategory\":\"IdentificadoÂ­res\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"InformaÃ§Ãµes de uso\",\"identifier\":\"USAGE_DATA\"},{\"dataCategory\":\"DiagnÃ³stico\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsBrazil\":{\"name\":\"Brazil L\",\"value\":100,\"rank\":6},\"appsApple\":{\"name\":\"+4\",\"value\":100,\"rank\":1}},\"deviceFamilies\":[\"watch\",\"iphone\",\"ipad\",\"ipod\"],\"chartPositions\":{\"appStore\":{\"position\":1,\"genreName\":\"NotÃ­cias\",\"genre\":6009,\"chart\":\"top-paid\",\"genreShortName\":\"NotÃ­cias\",\"chartLink\":\"https://apps.apple.com/br/charts/iphone/not%C3%ADcias-apps/6009\"}},\"supportsStreamlinedBuy\":true,\"url\":\"https://apps.apple.com/br/app/downcast/id393858566\",\"userRating\":{\"value\":4.3,\"ratingCount\":38,\"ratingCountList\":[2,4,0,8,24],\"ariaLabelForRatings\":\"4.3 estrelas\"},\"watchBundleId\":\"com.jamawkinaw.downcast.watchkitapp\",\"name\":\"Downcast\",\"genreDisplayName\":\"NotÃ­cias\",\"isPreorder\":false,\"artistName\":\"Jamawkinaw Enterprises LLC\",\"isIOSBinaryMacOSCompatible\":false,\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"watch\":{\"deviceFamily\":\"AppleÂ Watch\",\"requirementString\":\"Requer o watchOSÂ 7.1 ou posterior.\"},\"ipod\":{\"deviceFamily\":\"iPodÂ touch\",\"requirementString\":\"Requer o iOSÂ 14.7 ou posterior.\"},\"ipad\":{\"deviceFamily\":\"iPad\",\"requirementString\":\"Requer o iPadOSÂ 14.7 ou posterior.\"},\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requer o iOSÂ 14.7 ou posterior.\"}},\"minimumWatchOSVersion\":\"7.1\",\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.5\",\"description\":{\"standard\":\"A powerful, complete, and easy to use podcast player that will help you manage and listen to podcasts the way you want to.\\n\\nNow with CarPlay support!\\n\\n\\\"Downcast: Probably The Best Podcast Downloader for iPad and iPhone\\\" - Wired Gadget Lab\\n\\nSubscription Features\\nâ¢ Search, subscribe to and download audio and video podcasts of any size\\nâ¢ Manually subscribe to podcasts via URL \\nâ¢ Download podcasts automatically\\nâ¢ Continue podcast downloads in the background*\\nâ¢ Browse and download older podcast episodes \\nâ¢ Auto-refresh podcast feeds\\nâ¢ Settings for auto-download and episode retention\\nâ¢ Import and export podcast feeds via OPML \\nâ¢ Import supported audio/video media files\\nâ¢ Support for password-protected podcasts \\nâ¢ Create and edit \\\"smart\\\" playlists \\nâ¢ View podcast details and episode show notes \\nâ¢ Rename podcast titles \\n\\niCloud Syncing with other iOS devices or Macs**\\nâ¢ Podcast subscriptions\\nâ¢ Playlists\\nâ¢ Settings\\nâ¢ Episode information\\n\\nPlayback Features\\nâ¢ Video and audio AirPlay support\\nâ¢ .5x, 1x, 1.25x, 1.5x, 2x, 2.25x, 2.5x and 3x speed playback\\nâ¢ Chapters support for enhanced podcasts\\nâ¢ Stream episodes without downloading \\nâ¢ Playback control from external devices\\n    â¢ Bluetooth devices\\n    â¢ Headphone remote controls\\n    â¢ Devices connected via Lightning/dock connector\\nâ¢ View embedded images in podcast episodes \\nâ¢ Gesture support\\nâ¢ Sleep timer\\nâ¢ Google Castâ¢ Ready\\n\\n-----------------------------------------\\nFor support, please search our support site at http://support.downcastapp.com or email us at support@downcastapp.com!\\n\\nFor the latest information about Downcast, please follow @downcastapp on Twitter!\\n\\n* Per iOS restrictions\\n\\n** iCloud syncing with Macs requires Downcast for Mac, which is a separate purchase from the Mac App Store\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":true,\"requiredCapabilitiesForRealityDevice\":\"arm64 wifi \",\"versionHistory\":[{\"versionDisplay\":\"2.11.33\",\"releaseNotes\":\"* Dropped MS App Center for Crashlytics for opt-in crash reporting. No functional changes.\\n* Fixes a potential crash.\",\"releaseDate\":\"2025-01-26\",\"releaseTimestamp\":\"2025-01-26T17:21:29Z\"},{\"versionDisplay\":\"2.11.32\",\"releaseNotes\":\"â¢ Updates dark \u0026 tinted icon variations\",\"releaseDate\":\"2024-09-29\",\"releaseTimestamp\":\"2024-09-29T15:37:52Z\"},{\"versionDisplay\":\"2.11.31\",\"releaseNotes\":\"â¢ Adds dark \u0026 tinted icon variants for iOS 18\",\"releaseDate\":\"2024-09-26\",\"releaseTimestamp\":\"2024-09-26T09:38:20Z\"},{\"versionDisplay\":\"2.11.30\",\"releaseNotes\":\"â¢ Restores missing header view (artwork + podcast/episode title) on podcast details \u0026 episode detail views.\\nâ¢ Performance improvement when refreshing large feeds.\\nâ¢Â Fixes potential crash\\nâ¢ Fixes alignment issue for watchOS app on Apple Watch Ultra.\",\"releaseDate\":\"2024-09-16\",\"releaseTimestamp\":\"2024-09-16T11:43:57Z\"},{\"versionDisplay\":\"2.11.29\",\"releaseNotes\":\"â¢Â Fixes potential crash when playing on CarPlay\\nâ¢ Fixes potential crash when resuming playback using Siri\\nâ¢ Fixes a crash when deleting a ready-to-import file on the import files view\\nâ¢ Fixes issue with starting playback of podcasts and playlists using Siri. Also updates the suggested phrasing to use.\\nâ¢ Fixes issue with how the pull-to-refresh view is rendered\",\"releaseDate\":\"2024-08-18\",\"releaseTimestamp\":\"2024-08-18T20:13:26Z\"},{\"versionDisplay\":\"2.11.28\",\"releaseNotes\":\"â¢ Fixes issue with toolbar items staying disabled on a playlist when presenting the long-press action sheet on an episode row.\\nâ¢ Fixes potential crash\",\"releaseDate\":\"2024-02-01\",\"releaseTimestamp\":\"2024-02-01T20:51:38Z\"},{\"versionDisplay\":\"2.11.27\",\"releaseNotes\":\"â¢ Fixes issue with \\\"Select/Deselect\\\" button text when editing a list of episodes\\nâ¢ Fixes issue with using Siri to start a playlist called \\\"News\\\"\",\"releaseDate\":\"2023-10-15\",\"releaseTimestamp\":\"2023-10-15T18:35:37Z\"},{\"versionDisplay\":\"2.11.26\",\"releaseNotes\":\"â¢ Fixes a potential crash\",\"releaseDate\":\"2023-09-20\",\"releaseTimestamp\":\"2023-09-20T22:16:51Z\"},{\"versionDisplay\":\"2.11.25\",\"releaseNotes\":\"â¢ Fixes issue with playing m4b files\\nâ¢ Fixes issue with sharing feeds with no linkURL in their RSS feed\\nâ¢ Fixes issue with the podcasts list indicating there were no subscribed feeds when all feeds are just played or empty\\nâ¢ Fixes a few spacing issues on 45mm and 49mm watchOS devices\",\"releaseDate\":\"2023-08-28\",\"releaseTimestamp\":\"2023-08-28T19:36:11Z\"},{\"versionDisplay\":\"2.11.24\",\"releaseNotes\":\"â¢Â Workaround for an issue that prevented downloaded episodes from playing if the publisher had given them a file extension that didn't match the file's actual encoding.\\nâ¢ Accessibility - When editing a playlist, additional actions for moving an episode to the top or bottom of the list are now available.\",\"releaseDate\":\"2023-05-28\",\"releaseTimestamp\":\"2023-05-28T14:28:12Z\"},{\"versionDisplay\":\"2.11.23\",\"releaseNotes\":\"â¢ iPad - Skip Ahead/Skip Back keyboard shortcuts work again\\nâ¢ Fixes issue that could cause playback to stop when skipping ahead near the end of an episode.\",\"releaseDate\":\"2023-04-19\",\"releaseTimestamp\":\"2023-04-19T21:04:57Z\"},{\"versionDisplay\":\"2.11.22\",\"releaseNotes\":\"â¢ Fixed issue with PiP window not loading after tapping on a system notification.\\nâ¢ Fixed issue that could allow play position to be reset after returning from background\\nâ¢ Fixed issue with retrying failed downloads\",\"releaseDate\":\"2023-03-12\",\"releaseTimestamp\":\"2023-03-12T21:54:29Z\"},{\"versionDisplay\":\"2.11.21\",\"releaseNotes\":\"â¢ Fixes an issue where an episode could start playing if it finishes downloading after you'd started streaming it but switched to another downloaded episode prior to the download finishing.\",\"releaseDate\":\"2023-01-10\",\"releaseTimestamp\":\"2023-01-10T12:41:23Z\"},{\"versionDisplay\":\"2.11.20\",\"releaseNotes\":\"â¢ Fixes skipping forward/back by an arbitrary time interval using Siri. \\nâ¢ Fixes issue with volume slider position on player view after returning from background.\",\"releaseDate\":\"2022-12-23\",\"releaseTimestamp\":\"2022-12-23T15:05:06Z\"},{\"versionDisplay\":\"2.11.19\",\"releaseNotes\":\"â¢ For playlists that have \\\"Include All Podcasts\\\" disabled, there is a new setting available: \\\"Refreshes Unsubscribed\\\". When enabled, manually refreshing the playlist will also refresh any unsubscribed (Auto-Refresh disabled) podcasts that you've included in the playlist.\",\"releaseDate\":\"2022-11-19\",\"releaseTimestamp\":\"2022-11-19T00:00:28Z\"},{\"versionDisplay\":\"2.11.18\",\"releaseNotes\":\"â¢ CarPlay - Dismisses now playing view when playback ends due to there being no 'next' episode to play.\\nâ¢ When pulling down to refresh a playlist that has \\\"Include All\\\" disabled no longer refreshes included podcasts that have \\\"Auto-Refresh\\\" disabled.\\nâ¢ Fixes another issue with show notes on the player view being offset when returning to the player view.\\nâ¢Â Fixes potential crash\\nâ¢ Fixes issue preventing purchasing Tips (More -\u003e Support Downcast)\",\"releaseDate\":\"2022-11-11\",\"releaseTimestamp\":\"2022-11-11T15:53:16Z\"},{\"versionDisplay\":\"2.11.16\",\"releaseNotes\":\"â¢ iOS - Fixes label under the player scrubber where it would display \\\"Label\\\" the first time it was tapped after starting an episode\\nâ¢ iOS - Fixing potential startup crash\\nâ¢ iOS - Fixes potential crash when using Intents\\nâ¢ iOS - Fixes issue with retrying downloads that failed due to being redirected to an invalid URL\\nâ¢ CarPlay - Fixes navigation title on playlists\\nâ¢ CarPlay - Fixes syncing issue when Downcast isn't running and is launched directly from CarPlay. Prior to this, syncing would not work until the iOS app was launched.\",\"releaseDate\":\"2022-10-31\",\"releaseTimestamp\":\"2022-10-31T22:54:21Z\"},{\"versionDisplay\":\"2.11.15\",\"releaseNotes\":\"â¢ CarPlay - Additional information now shown on episode \u0026 chapter rows\\nâ¢ Fixes layout issue on Apple Watch Ultra\\nâ¢ Fixes issue with log file submission\\nâ¢ Fixes issue where episode details on player view would disappear after Downcast had been in the background\",\"releaseDate\":\"2022-10-18\",\"releaseTimestamp\":\"2022-10-18T20:45:44Z\"},{\"versionDisplay\":\"2.11.14\",\"releaseNotes\":\"â¢ Fixes issue with in-list search bar placement in iOS 16 when in landscape orientation\\nâ¢ Fixes potential crash\",\"releaseDate\":\"2022-09-16\",\"releaseTimestamp\":\"2022-09-16T14:32:12Z\"},{\"versionDisplay\":\"2.11.13\",\"releaseNotes\":\"â¢ Fixes a couple of potential crashes\\nâ¢ Fixes issues with now playing info not refreshing\",\"releaseDate\":\"2022-08-27\",\"releaseTimestamp\":\"2022-08-27T00:34:10Z\"},{\"versionDisplay\":\"2.11.12\",\"releaseNotes\":\"â¢ Fixes a crash that could occur if an episode contains incorrectly encoded ID3 chapter data. Specifically, this affected recent episodes of NPR's Short Wave podcast.\",\"releaseDate\":\"2022-08-04\",\"releaseTimestamp\":\"2022-08-04T22:47:11Z\"},{\"versionDisplay\":\"2.11.11\",\"releaseNotes\":\"â¢ Minor bug fixes\\nâ¢ Fixes a potential crash\",\"releaseDate\":\"2022-07-30\",\"releaseTimestamp\":\"2022-07-30T11:56:27Z\"},{\"versionDisplay\":\"2.11.10\",\"releaseNotes\":\"â¢ Fixes issue with chapters icon not showing in iOS 14\\nâ¢ Fixes crashed when skipping to the next chapter when the first chapter in an episode starts after the current play position\\nâ¢Â Fixes crash when playing episodes with chapters on CarPlay\",\"releaseDate\":\"2022-05-27\",\"releaseTimestamp\":\"2022-05-27T11:14:07Z\"},{\"versionDisplay\":\"2.11.9\",\"releaseNotes\":\"â¢ Fixes a potential startup crash\\nâ¢ Fixes issue where actions icon and level of detail icons on iOS 14\",\"releaseDate\":\"2022-04-05\",\"releaseTimestamp\":\"2022-04-05T12:25:40Z\"},{\"versionDisplay\":\"2.11.8\",\"releaseNotes\":\"â¢Â Fixes indication of current chapter in chapter lists\\nâ¢ Fixes issue with detecting chapter start/end times with certain podcasts\\nâ¢ Fixes UI glitch when leaving tips\\nâ¢ Fixes UI glitch when viewing episode details\",\"releaseDate\":\"2022-03-22\",\"releaseTimestamp\":\"2022-03-22T12:19:33Z\"}],\"websiteUrl\":\"https://downcast.fm\",\"minimumXROSVersion\":\"1.0\",\"isXROSCompatible\":false,\"hasSafariExtension\":false,\"messagesScreenshots\":{},\"requiresGameController\":false,\"offers\":[{\"buyParams\":\"productType=C\u0026price=14900\u0026salableAdamId=393858566\u0026pricingParameters=STDQ\u0026pg=phoenix\u0026appExtVrsId=871893653\",\"type\":\"buy\",\"pr