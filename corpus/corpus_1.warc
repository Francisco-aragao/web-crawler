ier\":\"LOCATION\"},{\"dataCategory\":\"IdentificadoÂ­res\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"InformaÃ§Ãµes de uso\",\"identifier\":\"USAGE_DATA\"},{\"dataCategory\":\"DiagnÃ³stico\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsBrazil\":{\"name\":\"Brazil L\",\"value\":100,\"rank\":6},\"appsApple\":{\"name\":\"+4\",\"value\":100,\"rank\":1}},\"deviceFamilies\":[\"iphone\",\"ipad\"],\"supportsStreamlinedBuy\":true,\"url\":\"https://apps.apple.com/br/app/photo-scout-by-cascable/id1629921985\",\"userRating\":{\"wasReset\":true,\"value\":5,\"ratingCount\":1,\"ratingCountList\":[0,0,0,0,1],\"ariaLabelForRatings\":\"5.0 estrelas\"},\"genreDisplayName\":\"Foto e vÃ­deo\",\"name\":\"Photo Scout by Cascable\",\"isPreorder\":false,\"artistName\":\"Cascable AB\",\"isIOSBinaryMacOSCompatible\":true,\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"ipad\":{\"deviceFamily\":\"iPad\",\"requirementString\":\"Requer o iPadOSÂ 16.4 ou posterior.\"},\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requer o iOSÂ 16.4 ou posterior.\"},\"mac\":{\"deviceFamily\":\"Mac\",\"requirementString\":\"Requer o macOSÂ 13.3 ou posterior e um Mac com o chip M1 da Apple ou posterior.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"13.3\",\"description\":{\"standard\":\"Photo Scout is for anyone who loves to be creative with a camera â be it an iPhone, DSLR/mirrorless camera, drone, film camera, or anything else!\\n\\nIt's your intelligent location assistant, scouting out your spots to tell you exactly when that perfect photo opportunity comes around. Unlike many other apps, Photo Scout is designed to be proactive - instead of having to check it every day, you'll get push notifications when opportunities arise, and you can add widgets to keep an eye on things right from your home screen.\\n\\nâ¢ If you love to travel, Photo Scout lets you enjoy your time away instead of spending it manually checking conditions.Â For the frequent traveller, the Instant Inspiration feature makes things even simpler by analysing the conditions at a chosen location and giving intelligent photo suggestions with just a couple of taps.\\n \\nâ¢ If you love a good sunset, sunset vibrancy requirements are for you.\\n\\nâ¢ If you love to fly drones, Photo Scout lets you fly safely with wind speed requirements.\\n\\nâ¢ If you love the night sky, Photo Scout lets you capture the cosmos with cloud cover, aurora, sunlight cycle, and moon requirements.\\n\\nâ¢ If you're a videographer or multi-day shooter, the opportunity chart feature helps keeps shots consistent by showing all upcoming opportunities for scenes over the coming days.\\n\\nNo matter what kind of photography you do, stop checking multiple apps every day and let Photo Scout do the work for you! You tell us where, we tell you when.\\n\\n----\\n\\nPhoto Scout comes with a seamless one-week free trial. After that, there are two levels of subscription available:\\n\\n- Hobbyist allows up to five scenes, hourly data updates, basic weather data, notifications the day before a photo opportunity becomes available, and Instant Inspiration for one day. \\n\\n- Professional gives unlimited scenes, more frequent data updates, extended weather data, Instant Inspiration for three days, fully customisable notifications, home screen widgets, custom icons, and more.\\n\\nIf you choose to subscribe to Photo Scout, the purchase will be charged to your App Store account. The subscription will automatically renew 24 hours before it runs out and you can manage it from User Settings in the App Store. Terms and Privacy Policy: http://photo-scout.app/privacy/.\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"websiteUrl\":\"https://photo-scout.app/\",\"versionHistory\":[{\"versionDisplay\":\"1.1.1\",\"releaseNotes\":\"This update adds Japanese localisation to Photo Scout. A warm welcome to our Japanese friends!\",\"releaseDate\":\"2024-03-11\",\"releaseTimestamp\":\"2024-03-11T19:06:42Z\"},{\"versionDisplay\":\"1.1\",\"releaseNotes\":\"This update adds Japanese localisation to Photo Scout. A warm welcome to our Japanese friends!\",\"releaseDate\":\"2024-02-16\",\"releaseTimestamp\":\"2024-02-16T11:15:12Z\"},{\"versionDisplay\":\"1.0.4\",\"releaseNotes\":\"This update improves the display of widgets in StandBy on iOS 17, and contains other minor improvements and fixes.\",\"releaseDate\":\"2023-10-27\",\"releaseTimestamp\":\"2023-10-27T19:09:49Z\"},{\"versionDisplay\":\"1.0.3\",\"releaseNotes\":\"This update improves compatibility with iOS 17, and improves the experience during the free trial.\",\"releaseDate\":\"2023-10-11\",\"releaseTimestamp\":\"2023-10-11T20:30:26Z\"},{\"versionDisplay\":\"1.0.2\",\"releaseNotes\":\"This update adds some (more) final polish for Photo Scout's launch.\",\"releaseDate\":\"2023-09-28\",\"releaseTimestamp\":\"2023-09-28T06:02:42Z\"},{\"versionDisplay\":\"1.0.1\",\"releaseNotes\":\"This update adds some final polish for Photo Scout's launch.\",\"releaseDate\":\"2023-09-25\",\"releaseTimestamp\":\"2023-09-25T07:25:19Z\"},{\"versionDisplay\":\"1.0\",\"releaseNotes\":null,\"releaseDate\":\"2023-09-14\",\"releaseTimestamp\":\"2023-09-14T14:57:23Z\"}],\"isXROSCompatible\":false,\"minimumXROSVersion\":\"1.0\",\"messagesScreenshots\":{},\"hasSafariExtension\":false,\"requiresGameController\":false,\"offers\":[{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1629921985\u0026pricingParameters=STDQ\u0026pg=phoenix\u0026appExtVrsId=864356976\",\"type\":\"get\",\"priceFormatted\":\"R$Â 0,00\",\"price\":0,\"priceString\":\"0.00\",\"currencyCode\":\"BRL\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":162317312}]},{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1629921985\u0026pricingParameters=SWUPD\u0026pg=phoenix\u0026appExtVrsId=864356976\",\"type\":\"update\",\"priceFormatted\":\"R$Â 0,00\"