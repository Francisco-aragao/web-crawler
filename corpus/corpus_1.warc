nk\":8,\"advisories\":[\"Temas adultos/sugestivos infrequentes/moderados\",\"InformaÃ§Ã£o mÃ©dica/tratamento infrequente/moderada\",\"Temas de terror/medo infrequentes/moderados\",\"Uso infrequente/moderado de obscenidades ou humor grosseiro\"]},\"appsApple\":{\"name\":\"+12\",\"value\":300,\"rank\":3,\"advisories\":[\"Temas adultos/sugestivos infrequentes/moderados\",\"InformaÃ§Ã£o mÃ©dica/tratamento infrequente/moderada\",\"Temas de terror/medo infrequentes/moderados\",\"Uso infrequente/moderado de obscenidades ou humor grosseiro\"]}},\"deviceFamilies\":[\"iphone\",\"ipod\"],\"supportsStreamlinedBuy\":true,\"url\":\"https://apps.apple.com/br/app/procast-podcast-app-podcasts/id1215380730\",\"userRating\":{\"value\":0,\"ratingCount\":0,\"ratingCountList\":[0,0,0,0,0],\"ariaLabelForRatings\":\"0 estrela\"},\"genreDisplayName\":\"NotÃ­cias\",\"name\":\"Procast Podcast App - Podcasts\",\"isPreorder\":false,\"artistName\":\"dsa Solutions GmbH\",\"isIOSBinaryMacOSCompatible\":true,\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"ipod\":{\"deviceFamily\":\"iPodÂ touch\",\"requirementString\":\"Requer o iOSÂ 12.1 ou posterior.\"},\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requer o iOSÂ 12.1 ou posterior.\"},\"mac\":{\"deviceFamily\":\"Mac\",\"requirementString\":\"Requer o macOSÂ 11.0 ou posterior e um Mac com o chip M1 da Apple ou posterior.\"},\"realityDevice\":{\"deviceFamily\":\"Apple Vision\",\"requirementString\":\"Requer o visionOSÂ 1.0 ou posterior.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"A new generation of Podcast Player. Enjoy a fast \u0026 intuitive user experience!\\n\\nProcast is made with the podcast novice in mind and offers compelling features for the experienced podcast listener. Plus Procast puts privacy first!\\n\\nINBOX\\nAll episodes for your subscribed podcasts arrive daily in your Inbox. We have a blazing fast cloud service that works 24/7 to deliver your podcasts.\\nSwipe new episodes (like Tinder) to quickly decide what you like and what you don't like. Download all podcasts for offline usage.\\n\\nMY PODCASTS\\nCheck your downloads, favorites and subscribe/unsubscribe from podcasts with a single tap\\n\\nDISCOVERY\\nBrowse the best podcasts by category and by country. Get inspiration and discover new podcasts from all over the world.\\n\\nPRIVACY\\nProcast collects no data and does not track you or what you are listening to! There's no need for a registration or login. We don't store any personal data in the cloud - everything you do stays on your iPhone! Plus it is 100% ad-free.\\n\\nPLAYER\\nBeautiful design, change podcast speed, sleep timer and video podcasts. Plus the \\\"Smart Player\\\" feature gives you customized night player.\\n\\nCUTS\\nCreate podcast snippets - we call them cuts. Easily cut out any part of a podcast and store it on your device. Share the best cuts with friends!\\n\\nDARK THEME\\nUse the dark theme when listening to those true crime stories under the covers...\\n\\nWORKS OFFLINE\\nDownload your episodes and enjoy podcasts wherever you are - with or without internet access\\n\\nIMPORT (OPML)\\nEasy import your podcasts from other podcast apps\\n\\nKIDS MODUS\\nTurns Procast into a Podcast App for kids. Only podcasts suited for kids can be selected and played.\\n\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"versionHistory\":[{\"versionDisplay\":\"2.7.7\",\"releaseNotes\":\"Small Bugfixes\",\"releaseDate\":\"2025-04-05\",\"releaseTimestamp\":\"2025-04-05T15:48:48Z\"},{\"versionDisplay\":\"2.7.5\",\"releaseNotes\":\"Bugfixes\",\"releaseDate\":\"2024-10-01\",\"releaseTimestamp\":\"2024-10-01T10:21:32Z\"},{\"versionDisplay\":\"2.7.4\",\"releaseNotes\":\"Various Bug Fixes\",\"releaseDate\":\"2024-04-20\",\"releaseTimestamp\":\"2024-04-20T13:17:31Z\"},{\"versionDisplay\":\"2.7.3\",\"releaseNotes\":\"Bug-Fixing\",\"releaseDate\":\"2024-01-04\",\"releaseTimestamp\":\"2024-01-04T08:41:00Z\"},{\"versionDisplay\":\"2.7.2\",\"releaseNotes\":\"CarPlay is back!\",\"releaseDate\":\"2023-10-23\",\"releaseTimestamp\":\"2023-10-23T06:22:10Z\"},{\"versionDisplay\":\"2.7.1\",\"releaseNotes\":\"Episode Images\\nBug Fixes\\n\",\"releaseDate\":\"2023-10-19\",\"releaseTimestamp\":\"2023-10-19T16:56:57Z\"},{\"versionDisplay\":\"2.7.0\",\"releaseNotes\":\"bug fixes\",\"releaseDate\":\"2023-10-09\",\"releaseTimestamp\":\"2023-10-09T15:38:03Z\"},{\"versionDisplay\":\"2.6.9\",\"releaseNotes\":\"- Support for iPhone15\\n- Removed Apple Car Play - this is no longer available in Procast until further notice\",\"releaseDate\":\"2023-10-03\",\"releaseTimestamp\":\"2023-10-03T11:56:21Z\"},{\"versionDisplay\":\"2.6.7\",\"releaseNotes\":\"#NEW#\\nYou can now delete all downloads for a podcast\",\"releaseDate\":\"2023-03-15\",\"releaseTimestamp\":\"2023-03-15T11:43:29Z\"},{\"versionDisplay\":\"2.6.6\",\"releaseNotes\":\"Small Bugfix for auto-deletion of old episodes\",\"releaseDate\":\"2023-01-29\",\"releaseTimestamp\":\"2023-01-29T14:18:34Z\"},{\"versionDisplay\":\"2.6.5\",\"releaseNotes\":\"Minor bug fixes\",\"releaseDate\":\"2022-12-11\",\"releaseTimestamp\":\"2022-12-11T11:32:47Z\"},{\"versionDisplay\":\"2.6.4\",\"releaseNotes\":\"Minor bug fixes\",\"releaseDate\":\"2022-10-26\",\"releaseTimestamp\":\"2022-10-26T06:12:56Z\"},{\"versionDisplay\":\"2.6.3\",\"releaseNotes\":\"#NEW#\\r\\n- Small design tweaks\\r\\n\",\"releaseDate\":\"2022-10-06\",\"releaseTimestamp\":\"2022-10-06T15:53:00Z\"},{\"versionDisplay\":\"2.6.2\",\"releaseNotes\":\"#NEW#\\n- Player Design\\n#FIXED#\\n- SmartPlayer\\n- Searchbar \",\"releaseDate\":\"2022-09-27\",\"releaseTimestamp\":\"2022-09-27T05:36:17Z\"},{\"versionDisplay\":\"2.6.1\",\"releaseNotes\":\"#FIXED#\\nFix for iPhone14/iOS16\",\"releaseDate\":\"2022-09-18\",\"releaseTimestamp\":\"2022-09-18T09:21:17Z\"},{\"versionDisplay\":\"2.6.0\",\"releaseNotes\":\"\\r\\n