\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"EntreteniÂ­mento\",\"url\":\"https://itunes.apple.com/br/genre/id6016\",\"parentId\":\"36\"}}]}},\"meta\":{\"contentVersion\":{\"RTCI\":1744753251664,\"MZ_INDEXER\":1744795851605}}},{\"id\":\"1540792803\",\"type\":\"apps\",\"href\":\"/v1/catalog/br/apps/1540792803?l=pt-BR\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Dados nÃ£o coletados\",\"identifier\":\"DATA_NOT_COLLECTED\",\"description\":\"Os desenvolvedores nÃ£o coletam nenhum dado deste app.\",\"dataCategories\":[]}]},\"contentRatingsBySystem\":{\"appsBrazil\":{\"name\":\"Brazil 12\",\"value\":300,\"rank\":8,\"advisories\":[\"Uso infrequente/moderado de obscenidades ou humor grosseiro\",\"Temas adultos/sugestivos infrequentes/moderados\"]},\"appsApple\":{\"name\":\"+9\",\"value\":200,\"rank\":2,\"advisories\":[\"Uso infrequente/moderado de obscenidades ou humor grosseiro\",\"Temas adultos/sugestivos infrequentes/moderados\"]}},\"deviceFamilies\":[\"watch\",\"iphone\",\"ipod\"],\"supportsStreamlinedBuy\":true,\"url\":\"https://apps.apple.com/br/app/podger-podcast-player/id1540792803\",\"userRating\":{\"value\":0,\"ratingCount\":0,\"ratingCountList\":[0,0,0,0,0],\"ariaLabelForRatings\":\"0 estrela\"},\"watchBundleId\":\"net.hesselbom.Podcast.watchkitapp\",\"name\":\"Podger - Podcast Player\",\"genreDisplayName\":\"NotÃ­cias\",\"isPreorder\":false,\"isIOSBinaryMacOSCompatible\":true,\"artistName\":\"Hesselbom Tech AB\",\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"watch\":{\"deviceFamily\":\"AppleÂ Watch\",\"requirementString\":\"Requer o watchOSÂ 7.0 ou posterior.\"},\"ipod\":{\"deviceFamily\":\"iPodÂ touch\",\"requirementString\":\"Requer o iOSÂ 14.0 ou posterior.\"},\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requer o iOSÂ 14.0 ou posterior.\"},\"mac\":{\"deviceFamily\":\"Mac\",\"requirementString\":\"Requer o macOSÂ 11.0 ou posterior e um Mac com o chip M1 da Apple ou posterior.\"},\"realityDevice\":{\"deviceFamily\":\"Apple Vision\",\"requirementString\":\"Requer o visionOSÂ 1.0 ou posterior.\"}},\"minimumWatchOSVersion\":\"7.0\",\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"Standalone podcast app for Apple Watch or iOS.\\n\\nSyncs episode progress between devices. Start listening on your phone and continue seamlessly from your watch when leaving your phone at home during a walk or a run!\\n\\nA premium subscription is available if you want to upload your own mp3 files. All other features are free!\\n\\nFeatures:\\n* Download or stream podcast episodes over Wi-Fi or mobile data\\n* Both iOS and Watch app works standalone\\n* Search for podcasts straight from your Watch\\n* Sync podcasts, episodes and progress between iOS and Watch app\\n* Add custom podcast feed URLs\\n* Individual episode artwork\\n* Adjust playback speed\\n* Adjust fast forward / rewind length\\n* Optional rewind when restarting paused episode, so you get a reminder where you were\\n* Quick remove played episodes\\n* Show podcast seasons + episode numbers\\n* Optimized for performance and battery life\\n* Group podcasts with podcast folders\\n* Podcast chapters (mp3, m4a, quicktime)\\n* Import/export podcasts from/to other apps in OPML format\\n\\nAny feedback and suggestions are welcome and together we'll make this the very best podcast app for iOS and Watch.\\n\\nTerms of Use: https://apple.com/legal/internet-services/itunes/dev/stdeula/\"},\"isStandaloneWithCompanionForWatchOS\":true,\"isAppleWatchSupported\":true,\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"versionHistory\":[{\"versionDisplay\":\"1.3.1\",\"releaseNotes\":\"* Fixes an issue where playback rate was not properly applied when pausing and then playing\\n* Fixes issue with sorting for custom collections\\n* Fixes an issue where custom collections would sometimes be hidden when offline\",\"releaseDate\":\"2022-08-16\",\"releaseTimestamp\":\"2022-08-16T09:09:23Z\"},{\"versionDisplay\":\"1.3.0\",\"releaseNotes\":\"* You can now become a premium member where you can upload and listen to your own mp3 files!\\n* Add custom feeds with or without password protection\\n* Various bug fixes including, but not limited to, support for more bluetooth headphones and various streaming bugs\",\"releaseDate\":\"2021-11-15\",\"releaseTimestamp\":\"2021-11-15T22:04:33Z\"},{\"versionDisplay\":\"1.2.5\",\"releaseNotes\":\"* Fixes issue where some podcast episodes were not found.\\n* Adds URL Scheme podger:// to allow deep linking into app\",\"releaseDate\":\"2021-04-23\",\"releaseTimestamp\":\"2021-04-23T16:36:55Z\"},{\"versionDisplay\":\"1.2.4\",\"releaseNotes\":\"Fixes issue where sometimes downloaded episodes would get the same filename.\",\"releaseDate\":\"2021-04-20\",\"releaseTimestamp\":\"2021-04-20T21:53:25Z\"},{\"versionDisplay\":\"1.2.3\",\"releaseNotes\":\"* Adds a \\\"New\\\" tag on podcasts where there is a new episode you haven't seen. Only available on iPhone to save data on Watch.\",\"releaseDate\":\"2021-04-19\",\"releaseTimestamp\":\"2021-04-19T15:43:59Z\"},{\"versionDisplay\":\"1.2.2\",\"releaseNotes\":\"* Fixes issue where app would sometimes crash after OPML import due to missing podcast image\",\"releaseDate\":\"2021-03-16\",\"releaseTimestamp\":\"2021-03-16T20:50:07Z\"},{\"versionDisplay\":\"1.2.1\",\"releaseNotes\":\"* Show latest episode date when searching for podcasts, to see immediately if the podcast is still active\",\"releaseDate\":\"2021-02-24\",\"releaseTimestamp\":\"2021-02-24T18:19:15Z\"},{\"versionDisplay\":\"1.2.0\",\"releaseNotes\":\"* Import/export podcasts from/to other apps in OPML format\\n* AirPlay\",\"releaseDate\":\"2021-02-23\",\"releaseTimestamp\":\"2021-02-23T18:43:05Z\"},{\"versionDisplay\":\"1.1.0\",\"releaseNotes\":\"* Group podcasts with podcast folders\\n* Podcast episode chapters\\n* Redesign \\\"Now Playing\\\" on Watch to be more easily accessible\\n* Various bug fixes\",\"releaseDate\":\"2021-01-26\",\"releaseTimestamp\":\"2021-01-26T16:33:10Z\"},{\"versionDisplay\":\"1.0.2\",\"releaseNotes\":\"* Fixes issue where sync would sometimes clear stored podcasts on Watch\\n* Adds support for anchor tag links in episode descriptions on iOS\",\"releaseDate\":\"2021-01-07\",\"releaseTimestamp\":\"2021-01-07T17:22:06Z\"},{\"versionDisplay\":\"1.0.1\",\"releaseNotes\":\"* Improved sync between Watch and Phone to work more reliably\\n* Added Watch complication\\n* Added dynamic text for accessibility\\n* Added swipe to remove episodes\\n* Show podcast seasons + episode numbers\\n* Various bug fixes\\n* New design\",\"releaseDate\":\"2021-01-05\",\"releaseTimestamp\":\"2021-01-05T23:01:48Z\"},{\"versionDisplay\":\"1.0\",\"releaseNotes\":null,\"releaseDate\":\"2020-12-10\",\"releaseTimestamp\":\"2020-12-10T00:51:09Z\"}],\"isXROSCompatible\":true,\"minimumXROSVersion\":\"1.0\",\"hasSafariExtension\":false,\"messagesScreenshots\":{},\"requiresGameController\":false,\"offers\":[{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1540792803\u0026pricingParameters=STDQ\u0026pg=phoenix\u0026appExtVrsId=851527294\",\"type\":\"get\",\"priceFormatted\":\"R$Â 0,00\",\"price\":0,\"priceString\":\"0.00\",\"currencyCode\":\"BRL\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":12952576}]},{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1540792803\u0026pricingParameters=SWUPD\u0026pg=phoenix\u0026appExtVrsId=851527294\",\"type\":\"update\",\"priceFormatted\":\"R$Â 0,00\",\"price\":0,\"priceString\":\"0.00\",\"currencyCode\":\"BRL\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":12952576}]}],\"requires32bit\":false,\"releaseDate\":\"2020-12-09\",\"hasInAppPurchases\":true,\"bundleId\":\"net.hesselbom.Podcast\",\"hasMessagesExtension\":false,\"artwork\":{\"width\":1024,\"height\":1024,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple122/v4/f8/6a/34