e\":\"NotÃ­cias\",\"url\":\"https://itunes.apple.com/br/genre/id6009\",\"parentId\":\"36\"}},{\"id\":\"6007\",\"type\":\"genres\",\"href\":\"/v1/catalog/br/genres/6007?l=pt-BR\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Produtividade\",\"url\":\"https://itunes.apple.com/br/genre/id6007\",\"parentId\":\"36\"}}]}},\"meta\":{\"contentVersion\":{\"RTCI\":1731532874478,\"MZ_INDEXER\":1744806019732}}},{\"id\":\"1572179241\",\"type\":\"apps\",\"href\":\"/v1/catalog/br/apps/1572179241?l=pt-BR\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Dados nÃ£o vinculados a vocÃª\",\"identifier\":\"DATA_NOT_LINKED_TO_YOU\",\"description\":\"Os seguintes dados podem ser coletados, mas nÃ£o estÃ£o vinculados Ã  sua identidade:\",\"dataCategories\":[{\"dataCategory\":\"InformaÃ§Ãµes de uso\",\"identifier\":\"USAGE_DATA\"},{\"dataCategory\":\"DiagnÃ³stico\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsBrazil\":{\"name\":\"Brazil L\",\"value\":100,\"rank\":6},\"appsApple\":{\"name\":\"+4\",\"value\":100,\"rank\":1}},\"deviceFamilies\":[\"iphone\"],\"supportsStreamlinedBuy\":true,\"url\":\"https://apps.apple.com/br/app/castflow-a-fast-podcast-app/id1572179241\",\"userRating\":{\"value\":0,\"ratingCount\":0,\"ratingCountList\":[0,0,0,0,0],\"ariaLabelForRatings\":\"0 estrela\"},\"firstVersionSupportingInAppPurchaseApi\":\"1.3.3\",\"name\":\"Castflow - A Fast Podcast App\",\"genreDisplayName\":\"NotÃ­cias\",\"isPreorder\":false,\"isIOSBinaryMacOSCompatible\":false,\"artistName\":\"ç¬ å§\",\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requer o iOSÂ 17.0 ou posterior.\"},\"realityDevice\":{\"deviceFamily\":\"Apple Vision\",\"requirementString\":\"Requer o visionOSÂ 1.0 ou posterior.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"14.0\",\"description\":{\"standard\":\"Castflow is a podcast app that recommends that users use subjective choices to listen to podcasts and avoid overuse of platform recommendation algorithms.\\n\\nCastflow feature list\\n- AI Transcript\\n- Explore new podcasts within the app\\n- Support Pocket casts, Overcast, Small Universe OPML batch import\\n- Support adding podcasts by RSS feed\\n- Queue play\\n- Adjustable multiplier speed\\n- Jumping audio blank\\n- Save cover\\n- Text mode\\n- Layout adjustment\\n- Episode show notes share long image\\n\\nGeneral version entitlement change: add up to 20 podcast shows (historical data is not affected)\\n\\n\\nIn-App Purchase:\\nPayment will be charged to your Apple ID account at the confirmation of purchase. Subscription automatically renews unless it is canceled at least 24 hours before the end of the current period.Your account will be charged for renewal within 24 hours prior to the end of the current period. You can manage and cancel your subscriptions by going to your account settings in the App Store after purchase.\\n\\nEmail\\njiangdi0924@gmail.com\\n\\nTerms: https://castflow-podcast.notion.site/Terms-b8d352e562864d53b119e0b1cf8fbfbf\\nPrivacy: https://castflow-podcast.notion.site/Privacy-Policy-41bb9727b7d34bf9a5f553f69a4eb822\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"versionHistory\":[{\"versionDisplay\":\"1.7.1\",\"releaseNotes\":\"- Optimize user experience\",\"releaseDate\":\"2025-04-16\",\"releaseTimestamp\":\"2025-04-16T21:31:27Z\"},{\"versionDisplay\":\"1.7.0\",\"releaseNotes\":\"- fix user feedback\",\"releaseDate\":\"2025-04-11\",\"releaseTimestamp\":\"2025-04-11T01:08:04Z\"},{\"versionDisplay\":\"1.6.4\",\"releaseNotes\":\"- Fix known issues and optimize user experience\",\"releaseDate\":\"2025-04-07\",\"releaseTimestamp\":\"2025-04-07T17:40:31Z\"},{\"versionDisplay\":\"1.6.3\",\"releaseNotes\":\"- fix user feedback errors\",\"releaseDate\":\"2025-04-06\",\"releaseTimestamp\":\"2025-04-06T11:42:24Z\"},{\"versionDisplay\":\"1.6.2\",\"releaseNotes\":\"- upgrade import OPML feature\\n- fix some error\",\"releaseDate\":\"2025-01-21\",\"releaseTimestamp\":\"2025-01-21T21:43:05Z\"},{\"versionDisplay\":\"1.6.1\",\"releaseNotes\":\"- fix errors \",\"releaseDate\":\"2024-12-30\",\"releaseTimestamp\":\"2024-12-30T10:12:05Z\"},{\"versionDisplay\":\"1.6.0\",\"releaseNotes\":\"- Add feature save AI Transcript Locallyï¼historical AI transcripts are available locally for review\",\"releaseDate\":\"2024-12-19\",\"releaseTimestamp\":\"2024-12-19T23:06:36Z\"},{\"versionDisplay\":\"1.5.9\",\"releaseNotes\":\"- fix iap issue\",\"releaseDate\":\"2024-12-16\",\"releaseTimestamp\":\"2024-12-16T05:24:11Z\"},{\"versionDisplay\":\"1.5.8\",\"releaseNotes\":\"- Fixing known issues\",\"releaseDate\":\"2024-10-28\",\"releaseTimestamp\":\"2024-10-28T20:03:37Z\"},{\"versionDisplay\":\"1.5.7\",\"releaseNotes\":\"- fix user feedback issues\",\"releaseDate\":\"2024-07-01\",\"releaseTimestamp\":\"2024-07-01T16:02:02Z\"},{\"versionDisplay\":\"1.5.6\",\"releaseNotes\":\"- fix import podcasts error\",\"releaseDate\":\"2024-06-20\",\"releaseTimestamp\":\"2024-06-20T18:56:03Z\"},{\"versionDisplay\":\"1.5.5\",\"releaseNotes\":\"- Fixed issues reported by users.\",\"releaseDate\":\"2024-05-12\",\"releaseTimestamp\":\"2024-05-12T16:13:14Z\"},{\"versionDisplay\":\"1.5.4\",\"releaseNotes\":\"- fix user feedback\",\"releaseDate\":\"2024-05-10\",\"releaseTimestamp\":\"2024-05-10T23:11:17Z\"},{\"versionDisplay\":\"1.5.3\",\"releaseNotes\":\"- fix issues\",\"releaseDate\":\"2024-05-07\",\"releaseTimestamp\":\"2024-05-07T14:22:11Z\"},{\"versionDisplay\":\"1.5.2\",\"releaseNotes\":\"- add episodes flow\",\"releaseDate\":\"2023-09-20\",\"releaseTimestamp\":\"2023-09-20T16:13:18Z\"},{\"versionDisplay\":\"1.5.1\",\"releaseNotes\":\"- fix errors\",\"releaseDate\":\"2023-09-11\",\"releaseTimestamp\":\"2023-09-11T08:13:08Z\"},{\"versionDisplay\":\"1.5.0\",\"releaseNotes\":\"- Redesigned the audio playback module.\\n- Improved playback loading speed.\\n- Fixed inaccuracies in the progress bar.\\n- Corrected inaccuracies in the duration.\\n- Optimized the playback details page.\\n- Enhanced audio playback performance.\\n- Temporarily removed the skip silence feature.\\nIf you encounter any issues with these functionalities, please feel free to provide feedback through comments or by sending us an email. Your input is valuable to us.\",\"releaseDate\":\"2023-09-06\",\"releaseTimestamp\":\"2023-09-06T16:05:16Z\"},{\"versionDisplay\":\"1.4.8\",\"releaseNotes\":\"- Fixed some minor issues.\\n\\n\\n\\n\",\"releaseDate\":\"2023-08-25\",\"releaseTimestamp\":\"2023-08-25T08:52:44Z\"},{\"versionDisplay\":\"1.4.7\",\"releaseNotes\":\" - General version entitlement changeï¼add up to 20 podcast shows (historical data is not affected)\\n - Optimize duration accuracy \\n\",\"releaseDate\":\"2023-01-29\",\"releaseTimestamp\":\"2023-01-29T00:41:37Z\"},{\"versionDisplay\":\"1.4.6\",\"releaseNotes\":\"- Support iOS16\\n- Fix some bug\",\"releaseDate\":\"2022-09-20\",\"releaseTimestamp\":\"2022-09-20T14:07:26Z\"},{\"versionDisplay\":\"1.4.3\",\"releaseNotes\":\"- New cache play\\n- Optimized trend page\\n- Improved performance reduced CPU and memory usage\\n- Added buy-out in-app purchase program\\n- Reduced App space usage\\n- Fixed abnormal podcast playback and abnormal audio status\\n- Fixed the problem that pictures and audio pictures are not displayed when locking the screen\",\"releaseDate\":\"2022-07-11\",\"releaseTimestamp\":\"2022-07-11T11:13:30Z\"},{\"versionDisplay\":\"1.4.2\",\"releaseNotes\":\"- Repair the problem of flickering pictures\\n- Optimized some styles\\n- Added podcast trend list\",\"releaseDate\":\"2022-06-22\",\"releaseTimestamp\":\"2022-06-22T17:02:12Z\"},{\"versionDisplay\":\"1.4.1\",\"releaseNotes\":\"- Add Apple Podcast synchronization function\\n- Fix some problems\",\"releaseDate\":\"2022-03-16\",\"releaseTimestamp\":\"2022-03-16T14:35:17Z\"},{\"versionDisplay\":\"1.4.0\",\"releaseNotes\":\"- Improved podcast playback responsiveness\\n- Dramatic reduction in CPU usage\\n- Fixed the problem that the show descriptions of some podcasts were not displayed\",\"releaseDate\":\"2022-02-24\",\"releaseTimestamp\":\"2022-02-24T10:37:21Z\"},{\"versionDisplay\":\"1.3.4\",\"releaseNotes\":\"- add episode  show notes share long image feature\\n- add request for review\\n- fix bugs\",\"releaseDate\":\"2022-01-31\",\"releaseTimestamp\":\"2022-01-31T06:46:36Z\"}],\"isXROSCompatible\":true,\"minimumXROSVersion\":\"1.0\",\"messagesScreenshots\":{},\"hasSafariExtension\":false,\"requiresGameController\":false,\"offers\":[{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1572179241\u0026pricingParameters=STDQ\u0026pg=phoenix\u0026appExtVrsId=874077873\",\"type\":\"get\",\"priceFormatted\":\"R$Â 0,00\",\"price\":0,\"priceString\":\"0.00\",\"currencyCode\":\"BRL\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":38126592}]},{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1572179241\u0026pricingParameters=SWUPD\u0026pg=phoenix\u0026appExtVrsId=874077873\",\"type\":\"update\",\"priceFormatted\":\"R$Â 0,00\",\"price\":0,\"priceString\":\"0.00\",\"currencyCode\":\"BRL\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":38126592}]}],\"requires32bit\":false,\"releaseDate\":\"2021-11-09\",\"hasInAppPurchases\":true,\"bundleId\":\"com.Castflow\",\"hasMessagesExtension\":false,\"artwork\":{\"width\":1024,\"height\":1024,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/0a/df/ee/0adfeec0-d048-9fa8-bef9-e35c7b5d135e/AppIcon-0-0-1x_U007emarketing-0-7-0-85-220.png/{w}x{h}{c}.{f}\",\"bgColor\":\"fffefe\",\"textColor1\":\"000000\",\"textColor2\":\"242424\",\"textColor3\":\"333232\",\"textColor4\":\"505050\"},\"privacyPolicyUrl\":\"https://castflow-podcast.notion.site/Privacy-Policy-41bb9727b7d34bf9a5f553f69a4eb822\",\"videoPreviewsByType\":{},\"isHiddenFromS