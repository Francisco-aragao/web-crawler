            console.error('[see-jserror] erro ao enviar erro :/', err.message);
            return undefined;
        }
    };

    window.onerror = function(message, file, line, column, error) {
        try {
            // utiliza try..catch para evitar loop
            window.ReportError({
                message: error ? error.message : message,
                stack: error ? error.stack : message+' at '+file+':'+line+':'+column
            });
        } catch(e) { console.error('[see-jserror] catch ', e) }
    };
})(window);</script> <script type="text/javascript">window._uolabtestsev=window._uolabtestsev||[]</script> <script async="" src="https://conteudo.jsuol.com.br/c/eloqua/api/index.iife.js"></script></head><body class="ecoa vertical anchorAds" data-anchorads="true" data-is-bot="false"><noscript><img src="https://sb.scorecardresearch.com/p?c1=2&amp;c2=6036356&amp;cv=4.4.0&amp;cj=1&amp;sd"/></noscript> <header class="header webalert_parent_container gradient thin reverse simple jupiter" data-chn-id="" data-has-scroll-metrics="" data-scroll-metrics=""> <div class="container"><div class="over"><div class="header-menu-lateral"> <nav class="header-menu gradient reverse thin min" data-async-header="false" data-menu-updated="20250129162839"> <div class="menu-action br" data-content="Menu" data-jsaudience='{"openMenu":{"action":"clique","component":"menu","reference":"menu-header-abrir","position":"coluna-unica","area":"barra-uol"},"closeMenu":{"action":"clique","component":"menu","reference":"menu-header-fechar","position":"coluna-unica","area":"barra-uol"},"channelTitleMenu":{"component":"menu","reference":"menu-header-abrir-estacao","area":"+-canais","position":"coluna-unica"},"closeMenuOutside":{"action":"clique","component":"menu","reference":"menu-header-fechar-fora","position":"coluna-unica","area":"barra-uol"},"rightMenu":{"action":"clique","component":"menu","reference":"menu-header-nav-direita","position":"coluna-unica","area":"barra-uol"},"leftMenu":{"action":"clique","component":"menu","reference":"menu-header-nav-esquerda","position":"coluna-unica","area":"barra-uol"},"topoMenuNivel1":{"component":"menu","reference":"menu-topo-nivel-1","position":"item-28","area":"passei-direto"}}'><svg class="menu-closed"> <use xlink:href="#svg-menu-hamburger-assimetrico"></use> </svg> <svg class="menu-opened"><use xlink:href="#svg-close"></use></svg></div> <div class="menu-layer"><ul class="menu-wrapper"> <li class="menu-item"><a data-audience-click='{"component":"menu","referenc