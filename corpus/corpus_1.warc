",\"ipad\",\"ipod\"],\"supportsStreamlinedBuy\":true,\"url\":\"https://apps.apple.com/br/app/podcast-player-shadow/id940127690\",\"userRating\":{\"value\":5,\"ratingCount\":1,\"ratingCountList\":[0,0,0,0,1],\"ariaLabelForRatings\":\"5.0 estrelas\"},\"firstVersionSupportingInAppPurchaseApi\":\"1\",\"genreDisplayName\":\"NotÃ­cias\",\"name\":\"Podcast Player | Shadow\",\"isPreorder\":false,\"isIOSBinaryMacOSCompatible\":false,\"artistName\":\"Andrew Conlan\",\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"ipod\":{\"deviceFamily\":\"iPodÂ touch\",\"requirementString\":\"Requer o iOSÂ 15.1 ou posterior.\"},\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requer o iOSÂ 15.1 ou posterior.\"},\"ipad\":{\"deviceFamily\":\"iPad\",\"requirementString\":\"Requer o iPadOSÂ 15.1 ou posterior.\"},\"realityDevice\":{\"deviceFamily\":\"Apple Vision\",\"requirementString\":\"Requer o visionOSÂ 1.0 ou posterior.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"12.0\",\"description\":{\"standard\":\"- Smart Downloads: Automatically downloads the next episode while deleting played.\\n- Intuitive Notifications: Notifies only when you are waiting on a new episode.\\n- Playback Speed: Adjusts using a time domain pitch algorithm for better vocal quality.\\n- SharePlay: Shared podcast playback experiences over FaceTime.\\n- Cloud Sync: Follows, playback times and settings in sync on all your devices.\\n- Chapters: Navigate between parts of an episode and view all embedded artwork.\\n- Widgets: Add an interactive Up Next widget to your home screen.\\n- Search: Find podcasts and play episodes without needing to follow first.\\n- Sleep Timer: Pause at the end of an episode or after a time interval you select.\\n- Appearance: Switch between light and dark appearance automatically.\\n- Filters: View only episodes of a podcast that are downloaded or not yet played.\\n- Private Feeds: Follow a podcast with a username and password.\\n- Privacy: No third-party analytics, ad services or tracking code.\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"websiteUrl\":\"https://shdw.app\",\"versionHistory\":[{\"versionDisplay\":\"19\",\"releaseNotes\":\"Improves playback handling when the media service is reset by the system.\",\"releaseDate\":\"2023-12-03\",\"releaseTimestamp\":\"2023-12-03T14:31:17Z\"},{\"versionDisplay\":\"18\",\"releaseNotes\":\"Adds interactive widget to manage playback.\",\"releaseDate\":\"2023-09-13\",\"releaseTimestamp\":\"2023-09-13T18:09:59Z\"},{\"versionDisplay\":\"17\",\"releaseNotes\":\"Fixes an issue were playback could continue after removing headphones.\",\"releaseDate\":\"2023-01-24\",\"releaseTimestamp\":\"2023-01-24T22:24:43Z\"},{\"versionDisplay\":\"16\",\"releaseNotes\":\"Fixes an issue with the current episode not being set when synced from another device.\\nAdds the ability to follow a private podcast by URL.\",\"releaseDate\":\"2022-04-13\",\"releaseTimestamp\":\"2022-04-13T22:14:04Z\"},{\"versionDisplay\":\"15\",\"releaseNotes\":\"Adds episode list filters for unplayed and downloaded.\",\"releaseDate\":\"2022-03-18\",\"releaseTimestamp\":\"2022-03-18T17:28:37Z\"},{\"versionDisplay\":\"14\",\"releaseNotes\":\"Adds episode list text search.\\nAdds spotlight search integration.\",\"releaseDate\":\"2022-02-25\",\"releaseTimestamp\":\"2022-02-25T22:48:18Z\"},{\"versionDisplay\":\"13\",\"releaseNotes\":\"Fixes an issue were the playback button wouldnât always toggle immediately.\\nImproves settings sync between devices.\\nRemoves episode view ad placement.\",\"releaseDate\":\"2022-02-07\",\"releaseTimestamp\":\"2022-02-07T19:08:21Z\"},{\"versionDisplay\":\"12\",\"releaseNotes\":\"Fixes an issue with playback scrubber not being updated when marking unplayed.\\nFixes an issue with marking an episode unplayed but it not resetting correctly.\\nAdds support for episode chapters with artwork.\\nAdds support for a sleep timer to automatically pause an episode.\",\"releaseDate\":\"2022-01-16\",\"releaseTimestamp\":\"2022-01-16T14:37:43Z\"},{\"versionDisplay\":\"11\",\"releaseNotes\":\"Fixes an issue with smart downloads deleting at the end of an episode when disabled.\\nFixes an issue with initiating the podcast database which caused an occasional crash.\\nImproves the underlying playback and sync engine.\\nAdds German Localisation.\",\"releaseDate\":\"2022-01-03\",\"releaseTimestamp\":\"2022-01-03T18:50:52Z\"},{\"versionDisplay\":\"10\",\"releaseNotes\":\"Fixes the tap area on the episode list more button to prevent accidental taps.\\nAdds swipe actions to episode list for download and played state.\",\"releaseDate\":\"2021-11-30\",\"releaseTimestamp\":\"2021-11-30T13:34:35Z\"},{\"versionDisplay\":\"9\",\"releaseNotes\":\"Fixes an issue when scrubbing before starting playback.\\nImproves the layout of the up next row and widget to unify their design.\\nImproves efficiency when the app is in the background.\",\"releaseDate\":\"2021-11-21\",\"releaseTimestamp\":\"2021-11-21T01:31:44Z\"},{\"versionDisplay\":\"8\",\"releaseNotes\":\"Fixes an issue with smart downloads working with unfollowed podcasts.\\nFixes an issue when selecting a download when the podcast is already playing.\\nImproves the episode screen to always show full playback controls.\",\"releaseDate\":\"2021-11-07\",\"releaseTimestamp\":\"2021-11-07T19:23:02Z\"},{\"versionDisplay\":\"7\",\"releaseNotes\":\"Fixes an issue with playing another episode from a notification.\\nAdds SharePlay support.\\nAdds an Up Next widget.\",\"releaseDate\":\"2021-10-19\",\"releaseTimestamp\":\"2021-10-19T19:06:14Z\"},{\"versionDisplay\":\"6\",\"releaseNotes\":\"Fixes an issue with the display of rectangular podcast artwork.\\nFixes an issue with episode descriptions not appearing from malformed XML.\\nFixes an issue where downloads were not deleted when episode marked played on a remote device.\\nFixes an issue where downloads were not deleted after an unfollow on a remote device.\\nFixes an issue where downloads were not deleted after an unfollow.\\nFixes an issue where the duration would take up space when hidden.\\nFixes an issue where the download indicator would take up space when hidden.\\nFixes an issue where the download indicator would not always appear.\\nAdds smart downloads option in settings.\",\"releaseDate\":\"2021-09-24\",\"releaseTimestamp\":\"2021-09-24T20:40:01Z\"},{\"versionDisplay\":\"5\",\"releaseNotes\":\"Fixes an issue where podcast details were not displaying after selecting a searched item.\\nFixes the wording in settings for import and export from subscriptions to follows.\\nFixes marking an episode as unplayed.\\nFixes an issue with consistent notifications for new episodes.\\nFixed animation when playing a played episode.\\nAdds ability to download episodes for offline playback.\\nAdds a downloads entry to settings for viewing all downloads.\\nAdds new menu options to the episode list.\\nAdds a message when search is unable to find a podcast.\\nAdds new search layout.\\nAdds pull to refresh to episode list.\\nAdds sidebar to iPad app.\\nAdds improved playback rate options.\\nImproves Cloud sync Engine.\",\"releaseDate\":\"2021-09-20\",\"releaseTimestamp\":\"2021-09-20T18:21:09Z\"},{\"versionDisplay\":\"4\",\"releaseNotes\":\"Fixes an issue where now playing wasn't cleared after playback when a new episode arrived.\\nFixes an issue where moving the scrubber to the end while paused would not mark an episode as played.\\nFixes an issue with views closing unexpectedly.\\nFixes an issue with the back button on the episode view disappearing.\\nFixes an issue where notifications may present for episodes incorrectly.\\nFixes an issue where navigation was failing on iPad by switching to stack layout.\\nFixes an issue with settings list items not deselecting on returning to the page.\\nAdds ability to adjust color scheme from within settings.\\nImproves sync between devices.\",\"releaseDate\":\"2021-05-03\",\"releaseTimestamp\":\"2021-05-03T14:46:58Z\"},{\"versionDisplay\":\"3\",\"releaseNotes\":\"Fixes an issue with notifications not appearing for an episode discovered on a different device.\\nFixes an issue with resetting the episode view when marking as played.\\nFixes an issue where episodes that were removed from a feed didn't clear now playing.\\nFixes an issue with refresh of the podcast grid after an OPML import.\\nAdds transition animation when loading new images.\\nAdds clearing of notifications older than 2 days.\\nImproves the animation when playing an episode in the episode view.\",\"releaseDate\":\"2021-04-20\",\"releaseTimestamp\":\"2021-04-20T21:52:46Z\"},{\"versionDisplay\":\"2\",\"releaseNotes\":\"Fixes an issue causing notifications to be sent for unfollowed podcasts\\nFixes an issue where unfollowing a podcast leaves a new episode in the recent shelf\\nFixes an issue with notification modal appearing more than once\\nFixes an issue with ads not displaying on launch for iPad\\nAdds full podcast details option to the follow screen\\nAdds promote and feedback links to settings\",\"releaseDate\":\"2021-04-18\",\"releaseTimestamp\":\"2021-04-18T08:26:41Z\"},{\"versionDisplay\":\"1\",\"releaseNotes\":null,\"releaseDate\":\"2021-04-14\",\"releaseTimestamp\":\"2021-04-14T15:46:55Z\"}],\"isXROSCompatible\":true,\"minimumXROSVersion\":\"1.0\",\"messagesScreenshots\":{},\"hasSafariExtension\":false,\"requiresGameController\":false,\"offers\":[{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=940127690\u0026pricingParameters=STDQ\u0026pg=phoenix\u0026appExtVrsId=861931522\",\"type\":\"get\",\"priceFormatted\":\"R$Â 0,00\",\"price\":0,\"priceString\":\"0.00\",\"currencyCode\":\"BRL\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":4965376}]},{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=940127690\u0026pricingParameters=SWUPD\u0026pg=phoenix\u0026appExtVrsId=861931522\",\"type\":\"update\",\"priceFormatted\":\"R$Â 0,00\",\"price\":0,\"priceString\":\"0.00\",\"currencyCode\":\"BRL\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":4965376}]}],\"requires32bit\":false,\"releaseDate\":\"2021-04-14\",\"hasInAppPurchases\":true,\"bundleId\":\"com.andrewconlan.shadow\",\"hasMessagesExtension\":false,\"artwork\":{\"width\":1024,\"height\":1024,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple116/v4/82/9b/74/829b747c-fe1e-dcf4-aee2-5e5777c89124/AppIcon-1x_U007emarketing-0-7-0-85-220-0.png/{w}x{h}{c}.{f}\",\"bgColor\":\"191919\",\"textColor1\":\"ff4141\",\"textColor2\":\"1b80fe\",\"textColor3\":\"d03939\",\"textColor4\":\"1a6bd0\"},\"privacyPolicyUrl\":\"https://shdw.app/privacy\",\"videoPreviewsByType\":{},\"isHiddenFromSpringboard\":false,\"isStandaloneForWatchOS\":false,\"supportURLForLanguage\":\"https://shdw.app\",\"isDeliveredInIOSAppForWatchOS\":false,\"editorialArtwork\":{\"contentIconTrimmedMonochrome\":{\"width\":990,\"height\":1080,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features126/v4/9b/2f/2c/9b2f2c8d-7f71-4b3d-b3f3-c095e9bdc1b5/bdb47b8f-9739-48e1-b674-ea7060cb7ac9.png/{w}x{h}{c}.{f}\",\"bgColor\":\"000000\",\"textColor1\":\"f2f2f2\",\"textColor2\":\"e5e5e5\",\"textColor3\":\"c1c1c1\",\"textColor4\":\"b7b7b7\"},\"contentIconTrimmed\":{\"width\":990,\"height\":1080,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features116/v4/54/2e/67/542e6752-1df2-3258-d9e6-fea572cced28/9891d8ca-05b5-4667-8bec-b3fc8b2ae24c.png/{w}x{h}{c}.{f}\",\"bgColor\":\"575c62\",\"textColor1\":\"fafbfc\",\"textColor2\":\"f0f1f2\",\"textColor3\":\"d9dbdd\",\"textColor4\":\"d1d3d5\"},\"brandLogo\":{\"width\":1080,\"height\":1080,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features116/v4/19/3e/cd/193ecd3c-921f-8967-67dc-1d3cd9b2ef75/37a49a21-fbec-4f71-966c-2fc8dbcb96b3.png/{w}x{h}{c}.{f}\",\"bgColor\":\"000000\",\"textColor1\":\"f2f2f2\",\"textColor2\":\"e5e5e5\",\"textColor3\":\"c1c1c1\",\"textColor4\":\"b7b7b7\"}},\"customAttributes\":{\"default\":{\"def