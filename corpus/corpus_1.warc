eFamily\":{\"watch\":{\"deviceFamily\":\"AppleÂ Watch\",\"requirementString\":\"Requer o watchOSÂ 8.7 ou posterior.\"},\"ipad\":{\"deviceFamily\":\"iPad\",\"requirementString\":\"Requer o iPadOSÂ 17.4 ou posterior.\"},\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requer o iOSÂ 17.4 ou posterior.\"},\"mac\":{\"deviceFamily\":\"Mac\",\"requirementString\":\"Requer o macOSÂ 14.4 ou posterior e um Mac com o chip M1 da Apple ou posterior.\"},\"realityDevice\":{\"deviceFamily\":\"Apple Vision\",\"requirementString\":\"Requer o visionOSÂ 1.1 ou posterior.\"}},\"hasEula\":false,\"minimumWatchOSVersion\":\"8.7\",\"distributionKind\":\"APP_STORE\",\"contentRatingsBySystem\":{\"appsBrazil\":{\"name\":\"Brazil 10\",\"value\":200,\"rank\":7,\"advisories\":[\"Uso infrequente/moderado de obscenidades ou humor grosseiro\"]},\"appsApple\":{\"name\":\"+9\",\"value\":200,\"rank\":2,\"advisories\":[\"Uso infrequente/moderado de obscenidades ou humor grosseiro\"]}},\"url\":\"https://apps.apple.com/br/app/icatcher-podcast-player/id414419105\",\"userRating\":{\"value\":4.9,\"ratingCount\":7,\"ratingCountList\":[0,0,0,1,6],\"ariaLabelForRatings\":\"4.9 estrelas\"},\"name\":\"iCatcher! Podcast Player\",\"genreDisplayName\":\"NotÃ­cias\",\"isPreorder\":false,\"artistName\":\"Joeisanerd.com\",\"isIOSBinaryMacOSCompatible\":true,\"sellerLabel\":\"Venda\",\"platformAttributes\":{\"ios\":{\"seller\":\"Joe Graf\",\"copyright\":\"Â© Joe Graf\",\"minimumMacOSVersion\":\"14.4\",\"description\":{\"standard\":\"Download, listen, watch and enjoy your favorite podcasts.\\n\\nFEATURES\\nâ¢ Subscribe to your favorite podcasts in the app and manage them in the app\\nâ¢ Download episodes over WiFi or Cellular (on devices that have cellular).\\nâ¢ Support for Password Protected feeds\\nâ¢ Background Refresh\\nâ¢ Download in the background\\nâ¢ Sync subscriptions, episode playback positions and playlists between your devices with iCloud\\nâ¢ Universal App (iPhone/iPad)\\nâ¢ Search in all views to find that podcast or episode you are looking for\\nâ¢ Custom playlists with filtering options by podcast, episodes and more.\\nâ¢ Support for continuous playback (toggle it on now playing screen just below time elapsed).\\nâ¢ All device orientations supported with configurable option in the settings\\nâ¢ You can unsubscribe to podcasts and still have them on your device. Use that for those less than stellar podcasts!\\n\\nPLAYBACK\\nâ¢ Variable playback speed\\nâ¢ Playback speed remembered per podcast\\nâ¢ Support for podcasts with chapters and chapter images (MP3 and M4A)\\nâ¢ Use your headset controls including Bluetooth car controls (when paired) to play/pause, jump forward or back 30 seconds\\nâ¢ Sleep timer\\nâ¢ Beautifully rendered show notes\\nâ¢ Onscreen controls for skipping ahead and skipping back\\nâ¢ Gesture Support on the now playing screen (when the podcast logo is showing) to aid in hands free use\\n    â¢ Double-tap to play/pause\\n    â¢ Swipe up to toggle playback speed\\n    â¢ Swipe left/right to rewind/fast-forward \\n    â¢ Home of the L gesture for the 2 minute Leo jump.\\nâ¢ See Settings and Gestures for more and for customizing rewind/fast-forward gestures\\nâ¢ Support for AirPlay, watch or listen to those podcasts on your big screen\\nâ¢ Support for external display of videos for devices that support an external display (get the Apple HDMI adapter)\\nâ¢ Watch or listen to your favorite podcasts with a familiar layout\\n\\nFIND NEW PODCASTS QUICK\\nâ¢ Find your podcasts by title, keyword or by author\\nâ¢ Browse the top podcasts by category\\nâ¢ Manually add podcasts with a URL\\n    â¢ Support for Password Protected feeds \\nâ¢ Option to download a single episode\\nâ¢ Browse the web in the app to find podcasts to add. Browser will prompt if you tap a link that is podcast feed.\\nâ¢ Import Podcast subscriptions for episodes that are already in your device from iTunes\\nâ¢ Import your OPML file from iTunes or other iOS podcast app\\nâ¢ Import media by using iTunes File Sharing feature\\nâ¢ Add your existing audiobooks (non-password protected ones) using iTunes File Sharing feature\\nâ¢ Add previously downloaded podcasts from your computer using iTunes file sharing feature (see settings and import media for details).\\n\\nMORE \\nâ¢ Completely customizable to meet your podcasts needs.\\nâ¢ Swipe across a podcast or episode to access additional options\\nâ¢ Podcast settings allow you to set the days the podcast typically comes out or the number of days between.\\nâ¢ Specify the number of episodes to download when new ones are available\\nâ¢ Share the podcast information via email with your friends\\n\\nCONTACT\\nEmail: tap Help tab and tap Email Support\\nTwitter/X: @Joeisanerd\\n\\nPLEASE NOTE: The app does NOT sync with iTunes. Like other podcast apps it is standalone app meant to subscribe and download on the device.\\n\\n* If a feed doesn't work, then let me know so I can take a look at it\\n\\nRequires iOS 17.4 or higher.\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":true,\"is32bitOnly\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"websiteUrl\":\"https://www.joeisanerd.com/\",\"versionHistory\":[{\"versionDisplay\":\"9.1.7\",\"releaseNotes\":\"If you get ongoing value from iCatcher, then please consider the Tip Jar in the help and settings tab or tell your friends about the app. Thank you\\n\\nFixes\\n-Fix for downloader\\n\\nView the Settings tab, Whatâs New to view past updates\\n\\nFollow me on x @joeisanerd and mastodon joeisanerd@techhub.social\",\"releaseDate\":\"2025-03-01\",\"releaseTimestamp\":\"2025-03-01T00:15:33Z\"},{\"versionDisplay\":\"9.1.6\",\"releaseNotes\":\"If you get ongoing value from iCatcher, then please consider the Tip Jar in the help and settings tab or tell your friends about the app. Thank you\\n\\nNew Stuff\\n+Another setting for skipping to next/previous episode. Settings tab, playback, controls, Next/Previous treated as skip Forward/Back. This doesn't change the skip buttons that show on the lock screen. This only affects issuing the command from headphones or other remove action.\\n\\nFixes\\n-Fix related to episode cleanup\\n-Fix for duplicate episodes checker in the Settings tab, other tools\\n\\n9.1.4 \u0026 9.1.5\\nNew Stuff\\n+Category selection updates on the beta podcasts tab (Settings / Experimental). Selecting a category and then tapping or pulling down to refresh will refresh only those podcasts.\\n\\nFixes\\n-Fix for search in settings tab not showing help topics\\n-Fix for tapping an episode in the podcast search that wasn't showing the current options.\\n-Fix for custom artwork selection on the Mac\\n-Fix for empty share sheet from the show notes popup\\n-Fix for images not showing right away in car play screen\\n-Fix for cleanup after playing\\n\\nView the Settings tab, Whatâs New to view past updates\\n\\nFollow me on x @joeisanerd and mastodon joeisanerd@techhub.social\",\"releaseDate\":\"2025-02-01\",\"releaseTimestamp\":\"2025-02-01T21:31:09Z\"},{\"versionDisplay\":\"9.1.5\",\"releaseNotes\":\"If you get ongoing value from iCatcher, then please consider the Tip Jar in the help and settings tab or tell your friends about the app. Thank you\\n\\nFixes\\n-Fix for search in settings tab not showing help topics\\n-Fix for tapping an episode in the podcast search that wasn't showing the current options.\\n\\nv9.1.4\\nNew Stuff\\n+Category selection updates on the beta podcasts tab (Settings / Experimental). Selecting a category and then tapping or pulling down to refresh will refresh only those podcasts.\\n\\nFixes\\n-Fix for custom artwork selection on the Mac\\n-Fix for empty share sheet from the show notes popup\\n-Fix for images not showing right away in car play screen\\n-Fix for cleanup after playing\\n\\nView the Settings tab, Whatâs New to view past updates\\n\\nFollow me on x @joeisanerd and mastodon joeisanerd@techhub.social\",\"releaseDate\":\"2025-01-22\",\"releaseTimestamp\":\"2025-01-22T07:51:12Z\"},{\"versionDisplay\":\"9.1.4\",\"releaseNotes\":\"If you get ongoing value from iCatcher, then please consider the Tip Jar in the help and settings tab or tell your friends about the app. Thank you\\n\\nNew Stuff\\n+Category selection updates on the beta podcasts tab (Settings / Experimental). Selecting a category and then tapping or pulling down to refresh will refresh only those podcasts.\\n\\nFixes\\n-Fix for custom artwork selection on the Mac\\n-Fix for empty share sheet from the show notes popup\\n-Fix for images not showing right away in car play screen\\n-Fix for cleanup after playing\\n\\nView the Settings tab, Whatâs New to view past updates\\n\\nFollow me on x @joeisanerd, mastodon joeisanerd@techhub.social, BlueSky @joeisanerd.bsky.social\",\"releaseDate\":\"2025-01-16\",\"releaseTimestamp\":\"2025-01-16T02:08:38Z\"},{\"versionDisplay\":\"9.1.3\",\"releaseNotes\":\"If you get ongoing value from iCatcher, then please consider the Tip Jar in the help and settings tab or tell your friends about the app. Thank you\\n\\nNew Stuff\\n+Option to disable the favorite button on the Lock Screen\\n+Updates to experimental podcasts tab UI. Including option to search for new podcast if search doesnât return any results. Ability to remove a category (select it first) from all podcasts. Option for showing ready to play badge.\\n+Clear filters message on podcasts tab when there is a filter, but nothing is showing.\\n+Added support back for older Apple Watch devices (series 3).\\n\\nFixes\\n-bug fixes related to playback controls.\\n\\nView the Settings tab, Whatâs New to view past updates\\n\\nFollow me on x @joeisanerd and mastodon joeisanerd@techhub.social\",\"releaseDate\":\"2024-12-22\",\"releaseTimestamp\":\"2024-12-22T18:06:29Z\"},{\"versionDisplay\":\"9.1.2\",\"releaseNotes\":\"If you get ongoing value from iCatcher, then please consider the Tip Jar in the help and settings tab or tell your friends about the app. Thank you\\n\\nNew Stuff\\n+Adding the view episodes option to the share action on podcast in the new beta podcasts tab (Settings tab, experimental).\\nFixed\\n-Fix for next/previous buttons on some devices where it should be skipping x seconds instead of next track.\\n\\n9.1.1, 9.1\\nNew Stuff\\n+Added support for the lock screen favorite/unfavorite an episode\\n+Added favorite option to episodes when performing tap and hold\\n+Sleep timer option to control how much it rewinds after timer ends\\n+Updated Playback-Controls-Remote Next/Previous Action Setting. The next in playlist item has been renamed and reconfigured. It is now Skip X, Next/Previous Episode when paused. Lock screen controls show the normal skip back and skip ahead controls while playing. When paused those controls disappear and instead show the next/previous track controls allow you to skip around\\n+Now requires watch OS 10\\n+New beta feature in the experimental settings. Working on a new podcast tab.\\n\\nBug Fixes\\n9.1.1/9.1\\n-Fix for stats view not showing images\\n-For for podcasts feed not showing titles properly in some cases\\n-Fix for skip chapters feature from the Lock Screen controls\\n-Fix for crashes related to podcast images\\n-Fix for crash when selected episodes in a playlist as well as in the downloads tab.\\n-Unicode fix for episode titles\\n-Fix for now playing view where it was hiding the home indicator every time, which also caused the Dynamic Island (top status) to disappear. This will now only happen if the now playing view is in fullscreen mode.\\n\\nView the Settings tab, Whatâs New to view past updates\\n\\nFollow me on x @joeisanerd and mastodon joeisanerd@techhub.social\",\"releaseDate\":\"2024-12-09\",\"releaseTimestamp\":\"2024-12-09T17:34:13Z\"},{\"versionDisplay\":\"9.1.1\",\"releaseNotes\":\"If you get ongoing value from iCatcher, then please consider the Tip Jar in the help and settings tab or tell your friends about the app. Thank you\\n\\n9.1.1\\nNew Stuff\\n+Added support for the lock screen favorite/unfavorite an episode\\n\\nBug fixes\\n-Fix for stats view not showing images\\n-For for podcasts feed not showing titles properly in some cases\\n-Fix for skip chapters feature from the Lock Screen controls\\n\\n9.1\\n+Added favorite option to episodes when performing tap and hold\\n+Sleep timer option to control how much it rewinds after timer ends\\n+Updated Playback-Controls-Remote Next/Previous Action Setting. The next in playlist item has been renamed and reconfigured. It is now Skip X, Next/Previous Episode when paused. Lock screen controls show the normal skip back and skip ahead controls while playing. When paused those controls disappear and instead show the next/previous track controls allow you to skip around\\n+Now requires watch OS 10\\n+New beta feature in the experimental settings. Working on a new podcast tab.\\n\\nBug Fixes\\n9.1\\n-Fix for crashes related to podcast images\\n-Fix for crash when selected episodes in a playlist as well as in the downloads tab.\\n-Unicode fix for episode titles\\n-Fix for now playing view where it was hiding the home indicator every time, which also caused the Dynamic Island (top status) to disappear. This will now only happen if the now playing view is in fullscreen mode.\\n\\nView the Settings tab, Whatâs New to view past updates\\n\\nFollow me on x @joeisanerd and mastodon joeisanerd@techhub.social\",\"releaseDate\":\"2024-12-08\",\"releaseTimestamp\":\"2024-12-08T18:38:27Z\"},{\"versionDisplay\":\"9.1\",\"releaseNotes\":\"If you get ongoing value from iCatcher, then please consider the Tip Jar in the help and settings tab or tell your friends about the app. Thank you\\n\\nNew Stuff\\n-Added favorite option to episodes when performing tap and hold\\n-Sleep timer option to control how much it rewinds after timer ends\\n-Updated Playback-Controls-Remote Next/Previous Action Setting. The next in playlist item has been renamed and reconfigured. It is now Skip X, Next/Previous Episode when paused. Lock screen controls show the normal skip back and skip ahead controls while playing. When paused those controls disappear and instead show the next/previous track controls allow you to skip around\\n-Now requires watch OS 10\\n-New beta feature in the experimental settings. Working on a new podcast tab.\\n\\nBug Fixes\\n-Fix for crashes related to podcast images\\n-Fix for crash when selected episodes in a playlist as well as in the downloads tab.\\n-Unicode fix for episode titles\\n-Fix for now playing view where it was hiding the home indicator every time, which also caused the Dynamic Island (top status) to disappear. This will now only happen if the now playing view is in fullscreen mode.\\n\\nView the Settings tab, Whatâs New to view past updates\\n\\nFollow me on x @joeisanerd and mastodon joeisanerd@techhub.social\",\"releaseDate\":\"2024-12-03\",\"releaseTimestamp\":\"2024-12-03T20:00:59Z\"},{\"versionDisplay\":\"9.0.2\",\"releaseNotes\":\"If you get ongoing value from iCatcher, then please consider the Tip Jar in the help and settings tab or tell your friends about the app. Thank you\\n\\nNew Stuff\\nv9.0.1\\n- Watch episodes that have chapters show an indicator (speaker icon) which chapter is currently playing. Also added artwork to those chapters if they have artwork.\\nv9.0\\n-Support for the latest iOS icon variations\\n- Updated car play buttons. Added next/previous to the available buttons\\n-Watch updates. New global playback rate option. New manual sorting option for episodes on downloaded to the watch. Drag to reorder. \\n\\nBug Fixes\\nv9.0.2\\n-Fix for watch podcast search\\n-Fix for watch showing selected chapter for phone playback\\nv9.0.1\\n-Fix for blurry artwork. Previous fix didn't fix all scenarios\\n-Fix for high cpu usage after a refresh causing crashes\\nv9.0\\n-Fix for playlist crash when the playlist uses a podcast category keyword\\n-Fix for editing podcast settings\\n-Fix for CarPlay disabled buttons. \\n-Fix for blurry artwork\\n-Numerous other fixes\\n\\nView the Settings tab, Whatâs New to view past updates\\n\\nFollow me on x @joeisanerd and mastodon joeisanerd@techhub.social\",\"releaseDate\":\"2024-10-16\",\"releaseTimestamp\":\"2024-10-16T19:58:57Z\"},{\"versionDisplay\":\"9.0.1\",\"releaseNotes\":\"If you get ongoing value from iCatcher, then please consider the Tip Jar in the help and settings tab or tell your friends about the app. Thank you\\n\\nNew Stuff\\nv9.0.1\\n- Watch episodes that have chapters show an indicator (speaker icon) which chapter is currently playing. Also added artwork to those chapters if they have artwork.\\nv9.0\\n-Support for the latest iOS icon variations\\n- Updated car play buttons. Added next/previous to the available buttons\\n-Watch updates. New global playback rate option. New manual sorting option for episodes on downloaded to the watch. Drag to reorder. \\n\\nBug Fixes\\nv9.0.1\\n-Fix for blurry artwork. Previous fix didn't fix all scenarios\\n-Fix for high cpu usage after a refresh causing crashes\\nv9.0\\n-Fix for playlist crash when the playlist uses a podcast category keyword\\n-Fix for editing podcast settings\\n-Fix for CarPlay disabled buttons. \\n-Fix for blurry artwork\\n-Numerous other fixes\\n\\nView the Settings tab, Whatâs New to view past updates\\n\\nFollow me on x @joeisanerd and mastodon joeisanerd@techhub.social\",\"releaseDate\":\"2024-10-13\",\"releaseTimestamp\":\"2024-10-13T17:06:20Z\"},{\"versionDisplay\":\"9.0\",\"releaseNotes\":\"If you get ongoing value from iCatcher, then please consider the Tip Jar in the help and settings tab or tell your friends about the app. Thank you\\n\\nNew Stuff\\n-Support for the latest iOS icon variations\\n- Updated car play buttons. Added next/previous to the available buttons\\n-Watch updates. New global playback rate option. New manual sorting option for episodes on downloaded to the watch. Drag to reorder. \\n\\nBug Fixes\\n-Fix for playlist crash when the playlist uses a podcast category keyword\\n-Fix for editing podcast settings\\n-Fix for CarPlay disabled buttons. \\n-Fix for blurry artwork\\n-Numerous other fixes\\n\\nView the Settings tab, Whatâs New to view past updates\\n\\nFollow me on x @joeisanerd and mastodon joeisanerd@techhub.social\",\"releaseDate\":\"2024-10-11\",\"releaseTimestamp\":\"2024-10-11T02:35:46Z\"},{\"versionDisplay\":\"8.2.9\",\"releaseNotes\":\"If you get ongoing value from iCatcher, then please consider the Tip Jar in the help and settings tab or tell your friends about the app. Thank you\\n\\nBug Fixes\\n-Fix when subscribing to a feed that does a non-permanent redirect\\n-Fixes related to podcasting 2.0 and transcripts\\n-Fix for podcast feeds that included some basic html within a tag without using CDATA like they are supposed to.\\n-Adding the follow/subscribe button back on the podcast details page when viewing a podcast that is in your not following area\\n\\nView the Settings tab, Whatâs New to view past updates\\n\\nFollow me on x @joeisanerd and mastodon joeisanerd@techhub.social\",\"releaseDate\":\"2024-05-31\",\"releaseTimestamp\":\"2024-05-31T05:40:53Z\"},{\"versionDisplay\":\"8.2.8\",\"releaseNotes\":\"If you get ongoing value from iCatcher, then please consider the Tip Jar in the help and settings tab or tell your friends about the app. Thank you\\n\\nNew Stuff\\n+For podcasts that have podcast index support for the person tag the info people will show in the show notes below the episodes published date. If they have an image that will show too. Tapping the name will show more details.\\n\\nBug Fixes\\n-Fix for tap bar missing after video playback ends that was in portrait fullscreen\\n-Fix for audio cutting out in some situations when locking the phone\\n-Fix for handling podcast feed that doesn't change title of episode, but changes the file download url and misuses GUID.\\n\\nView the Settings tab, Whatâs New to view past updates\\n\\nFollow me on x @joeisanerd and mastodon joeisanerd@techhub.social\",\"releaseDate\":\"2024-05-07\",\"releaseTimestamp\":\"2024-05-07T22:16:20Z\"},{\"versionDisplay\":\"8.2.7\",\"releaseNotes\":\"If you get ongoing value from iCatcher, then please consider the Tip Jar in the help and settings tab or tell your friends about the app. Thank you\\n\\nNew Stuff\\n+Updated sorts within a podcast and within playlists to sort by date (day) then title A-Z. This is to handle the scenario where a podcast has episodes on a day, but publishes the Hour 1, Hour 2, Hour 3 out of pub date order.\\n\\nBug Fixes\\n-Fix for shortcuts action for creating a bookmark. The playback position parameter wasn't taking affect.\\n-Fixes related to iCloud sync\\n-Fix for chapters in show notes               \\n\\nView the Settings tab, Whatâs New to view past updates\\n\\nFollow me on x @joeisanerd and mastodon joeisanerd@techhub.social\",\"releaseDate\":\"2024-04-20\",\"releaseTimestamp\":\"2024-04-20T21:50:32Z\"},{\"versionDisplay\":\"8.2.6\",\"releaseNotes\":\"If you get ongoing value from iCatcher, then please consider the Tip Jar in the help and settings tab or tell your friends about the app. Thank you\\n\\nBug Fixes\\n-Additional bug fixes for crashes in certain areas\\n-Fix for importing feeds not saving\\n-Fix for crash when accessing the stats area\\n\\n8.2.1\\nBug Fixes\\n-Fix for changing podcast sort within a podcasts settings\\n-Fix for some podcast feeds not recognizing new episodes media files.\\n\\n8.2\\nNew Stuff\\n+Updates to the Watch Now Playing view\\n+Shortcuts app, new iCatcher shortcuts available: Add to Playlist; Settings search; Navigate To (opens iCatcher to a particular area like the now playing screen).\\n\\nBug Fixes\\n-Fix for the user agent setting.\\n-Fix for issue where streaming episode gets marked as played due to playback error\\n-Feed processing bug fixes\\n-Possible fixes for certain crashes\\n-Fix for video playback issue where it could show a flash of a white screen when starting playback\\n-Shortcuts fix for View Podcast action to allow for variables. Example, now you can link the Currently Playing with the View Podcast to navigate to the currently playing podcast via shortcut.\\n\\nView the Settings tab, Whatâs New to view past updates\\n\\nFollow me on x @joeisanerd and mastodon joeisanerd@techhub.social\",\"releaseDate\":\"2024-03-18\",\"releaseTimestamp\":\"2024-03-18T21:34:48Z\"},{\"versionDisplay\":\"8.2.1\",\"releaseNotes\":\"If you get ongoing value from iCatcher, then please consider the Tip Jar in the help and settings tab or tell your friends about the app. Thank you\\n\\nBug Fixes\\n-Fix for changing podcast sort within a podcasts settings\\n-Fix for some podcast feeds not recognizing new episodes media files.\\n-Fix for some crashing scenarios\\n-Fix for fullscreen video finishing and not showing the top navigation bar\\n\\n8.2\\nNew Stuff\\n+Updates to the Watch Now Playing view\\n+Shortcuts app, new iCatcher shortcuts available: Add to Playlist; Settings search; Navigate To (opens iCatcher to a particular area like the now playing screen).\\n\\nBug Fixes\\n-Fix for the user agent setting.\\n-Fix for issue where streaming episode gets marked as played due to playback error\\n-Feed processing bug fixes\\n-Possible fixes for certain crashes\\n-Fix for video playback issue where it could show a flash of a white screen when starting playback\\n-Shortcuts fix for View Podcast action to allow for variables. Example, now you can link the Currently Playing with the View Podcast to navigate to the currently playing podcast via shortcut.\\n\\nView the Settings tab, Whatâs New to view past updates\\n\\nFollow me on x @joeisanerd and mastodon joeisanerd@techhub.social\",\"releaseDate\":\"2024-03-14\",\"releaseTimestamp\":\"2024-03-14T19:28:27Z\"},{\"versionDisplay\":\"8.2\",\"releaseNotes\":\"If you get ongoing value from iCatcher, then please consider the Tip Jar in the help and settings tab or tell your friends about the app. Thank you\\n\\nNew Stuff\\n+Updates to the Watch Now Playing view\\n+Shortcuts app, new iCatcher shortcuts available: Add to Playlist; Settings search; Navigate To (opens iCatcher to a particular area like the now playing screen).\\n\\nBug Fixes\\n-Fix for the user agent setting.\\n-Fix for issue where streaming episode gets marked as played due to playback error\\n-Feed processing bug fixes\\n-Possible fixes for certain crashes\\n-Fix for video playback issue where it could show a flash of a white screen when starting playback\\n-Shortcuts fix for View Podcast action to allow for variables. Example, now you can link the Currently Playing with the View Podcast to navigate to the currently playing podcast via shortcut.\\n\\nView the Settings tab, Whatâs New to view past updates\\n\\nFollow me on x @joeisanerd and mastodon joeisanerd@techhub.social\",\"releaseDate\":\"2024-03-06\",\"releaseTimestamp\":\"2024-03-06T21:44:24Z\"},{\"versionDisplay\":\"8.1.5\",\"releaseNotes\":\"If you get ongoing value from iCatcher, then please consider the Tip Jar in the help and settings tab or tell your friends about the app. Thank you\\n\\nNew Stuff\\n+Selecting multiple episodes within a podcast now has a similar playlist actions available instead of just Add to Playlist. If those episodes are all in a playlist, then it would show the option to remove instead of add. This behavior was already done for single episode actions\\n\\nBug fixes\\n-Fix for the skip back previous action via headphones\\n\\n8.1.4 \\nNew Stuff\\n+Updated sleep timer actions available in the shortcuts app\\n+Add next/previous episode Siri shortcut option in settings, Siri shortcuts\\n+New actions available in the shortcuts app. Including:\\n++View Podcast. Navigate to a podcast within the app\\n++Playlist Details. Returns details like episode count \u0026 episode details. Can be used with other actions\\n++Chapter Skipping updated with option to go to current chapter (restarting it).\\n++Updated Podcast Episode filters allowing you to find episodes that are in/not in a playlist as well as apply the pub date filters like latest unplayed, oldest unplayed, etc.\\n\\nBug Fixes\\n-Fix for the latest unplayed pub date for each podcast. You will need to refresh your podcasts for the dates to get fixed. This affected playlists created that used the latest unplayed pub date option\\n-Bug fix for interrupt and resume playback. This might also have caused playback to start while in the background after a period of time\\n-Fix for animation when tapping the skip ahead and skip back\\n\\nView the Settings tab, Whatâs New to view past updates\\n\\nFollow me on x @joeisanerd and mastodon joeisanerd@techhub.social\",\"releaseDate\":\"2024-01-18\",\"releaseTimestamp\":\"2024-01-18T02:04:03Z\"},{\"versionDisplay\":\"8.1.4\",\"releaseNotes\":\"If you get ongoing value from iCatcher, then please consider the Tip Jar in the help and settings tab or tell your friends about the app. Thank you\\n\\nNew Stuff\\n+Updated sleep timer actions available in the shortcuts app\\n+Add next/previous episode Siri shortcut option in settings, Siri shortcuts\\n+New actions available in the shortcuts app. Including:\\n++View Podcast. Navigate to a podcast within the app\\n++Playlist Details. Returns details like episode count \u0026 episode details. Can be used with other actions\\n++Chapter Skipping updated with option to go to current chapter (restarting it).\\n++Updated Podcast Episode filters allowing you to find episodes that are in/not in a playlist as well as apply the pub date filters like latest unplayed, oldest unplayed, etc.\\n\\nBug Fixes\\n-Fix for the latest unplayed pub date for each podcast. You will need to refresh your podcasts for the dates to get fixed. This affected playlists created that used the latest unplayed pub date option\\n-Bug fix for interrupt and resume playback. This might also have caused playback to start while in the background after a period of time\\n-Fix for animation when tapping the skip ahead and skip back\\n\\nView the Settings tab, Whatâs New to view past updates\\n\\nFollow me on x @joeisanerd and mastodon joeisanerd@techhub.social\",\"releaseDate\":\"2024-01-15\",\"releaseTimestamp\":\"2024-01-15T19:41:12Z\"},{\"versionDisplay\":\"8.1.3\",\"releaseNotes\":\"If you get ongoing value from iCatcher, then please consider the Tip Jar in the help and settings tab or tell your friends about the app. Thank you\\n\\nNew Stuff\\n+Updated the category settings for a podcast so it functions like the episodes to include/ignore.\\n+Local watch playback has a new option when you double tap the playback rate. This will present a control to change the playback rate ranging from 0.5 to 3.0 in .1 increments\\n+Add Top 10 podcasts listened to in the settings Stats\\n\\nBug Fixes\\n-Fix for overlapping text on now playing below the time slider.\\n-Fix for gestures not working on now playing for some scenarios.\\n-Fix for paid/premium podcasts that have a user id and password not completing the follow/subscribe process.\\n\\nView the Settings tab, Whatâs New to view past updates\\n\\nFollow me on x @joeisanerd and mastodon joeisanerd@techhub.social\",\"releaseDate\":\"2023-12-18\",\"releaseTimestamp\":\"2023-12-18T18:50:25Z\"},{\"versionDisplay\":\"8.1.2\",\"releaseNotes\":\"If you get ongoing value from iCatcher, then please consider the Tip Jar in the help and settings tab or tell your friends about the app. Thank you\\n\\nNew Stuff\\n+Playlist settings adjustment so newer than and older than use complete day (midnight) instead of current time. Example newer than 2 days includes today and yesterday published date.\\n+Added preview action for episodes when viewing a podcasts feed that you already have in iCatcher. Previously this will limited to episodes that were not already on the device\\n+Updated the tap and hold on episodes to include a download now option if the episode is queued\\n+Consolidated the tap and hold add to playlist/download + playlist option. After selecting a playlist if the episodes is not ready to play/queued for download, then it will prompt with options. This option now allows you select a playlist that it was explicitly added to and have it remove it from that playlist.\\n+Consolidated the add to playlist/download + playlist when tapping a single episode. This is now just playlists like the tap and hold. After adding a playlist if the episodes is not ready to play/queued for download, then it will prompt with options.\\n+New View Podcast app intent shortcut\\n\\nBug Fixes\\n-Fix for voice over bug after dismissing show notes. Phantom Remove prepended to episode title\\n-Fix for Chapters toc = false for podcasting 2.0 chapters\\n-Fix for Fast-forward/rewind where it would reset to 1x\\n-Fix for show notes not showing completely on some devices\\n\\nView the Settings tab, Whatâs New to view past updates\\n\\nFollow me on x @joeisanerd and mastodon joeisanerd@techhub.social\",\"releaseDate\":\"2023-12-06\",\"releaseTimestamp\":\"2023-12-06T18:39:08Z\"},{\"versionDisplay\":\"8.1.1\",\"releaseNotes\":\"If you get ongoing value from iCatcher, then please consider the Tip Jar in the help and settings tab or tell your friends about the app. Thank you\\n\\nBug fixes for 8.1.1\\n+Performance improvements to address CPU spikes leading to crashes\\n+Fix for sluggish scrolling due to issue with where the app was looking for store files.\\n\\nBug fixes for 8.1\\n+Fix for sort order on podcasts tab ready to play (most, then recent)\\n+Fix for episodes to ignore missing add button\\n+Fix for oldest unplayed playlist setting (after refresh)\\n+Fix for missing chapter/bookmark button after creating a bookmark\\n\\nNew Stuff in 8.0\\n+Interactive Widgets on supported devices\\n+Updated Now Playing view to closer match what the experimental now playing view has had for a long time now.\\n+Support for episode images. Some podcasts add downloadable images for each episode. If the setting is enabled, then those images will be downloaded when starting playback for the selected episode. Settings tab, Appearance, Episode Images from Feed.\\n+Ability to export a playlist (settings) to send to someone else or to send to another device. This doesn't send the contents, just the settings/rules for that playlist.\\n+Export settings to transfer to another app or just to save and restore later.\\n+New option in Settings, playback, general, Max Audio Volume. This is separate from the devices volume. Useful for those that have asked for lower volume\\n+Help tab removed and merged with the settings tab. Settings tab search now includes searching help topics. At least the help topic titles.\\n+Subscribe is now Follow. A change other apps have made some time ago.\\n+Additional app intents available through the shortcuts app for iOS 16.\\n+Added Command+Option+Left and Command+Option+Right shortcuts for skip back and skip forward to work better on the Mac\\n+New playlist published date filter added, Oldest Ready to Play. Podcasts would need to be refreshed for the property to be updated.\\n\\nView the Settings tab, Whatâs New to view past updates\\n\\nFollow me on x @joeisanerd and mastodon joeisanerd@techhub.social\",\"releaseDate\":\"2023-11-09\",\"releaseTimestamp\":\"2023-11-09T08:12:29Z\"},{\"versionDisplay\":\"8.1\",\"releaseNotes\":\"If you get ongoing value from iCatcher, then please consider the Tip Jar in the help and settings tab or tell your friends about the app. Thank you\\n\\nBug fixes for 8.1\\n+Fix for sort order on podcasts tab ready to play (most, then recent)\\n+Fix for episodes to ignore missing add button\\n+Fix for oldest unplayed playlist setting (after refresh)\\n+Fix for missing chapter/bookmark button after creating a bookmark\\n\\nNew Stuff in 8.0\\n+Interactive Widgets on supported devices\\n+Updated Now Playing view to closer match what the experimental now playing view has had for a long time now.\\n+Support for episode images. Some podcasts add downloadable images for each episode. If the setting is enabled, then those images will be downloaded when starting playback for the selected episode. Settings tab, Appearance, Episode Images from Feed.\\n+Ability to export a playlist (settings) to send to someone else or to send to another device. This doesn't send the contents, just the settings/rules for that playlist.\\n+Export settings to transfer to another app or just to save and restore later.\\n+New option in Settings, playback, general, Max Audio Volume. This is separate from the devices volume. Useful for those that have asked for lower volume\\n+Help tab removed and merged with the settings tab. Settings tab search now includes searching help topics. At least the help topic titles.\\n+Subscribe is now Follow. A change other apps have made some time ago.\\n+Additional app intents available through the shortcuts app for iOS 16.\\n+Added Command+Option+Left and Command+Option+Right shortcuts for skip back and skip forward to work better on the Mac\\n+New playlist published date filter added, Oldest Ready to Play. Podcasts would need to be refreshed for the property to be updated.\\n\\nView the Settings tab, Whatâs New to view past updates\\n\\nFollow me on x @joeisanerd and mastodon joeisanerd@techhub.social\",\"releaseDate\":\"2023-10-31\",\"releaseTimestamp\":\"2023-10-31T20:41:02Z\"},{\"versionDisplay\":\"8.0\",\"releaseNotes\":\"If you get ongoing value from iCatcher, then please consider the Tip Jar in the help and settings tab or tell your friends about the app. Thank you\\n\\nBug Fixes\\n+Fix for add to playlist from within a podcast tapping the share icon\\n+Fix for Copy MP3 link share action\\n+Fix for AirPlay Mirroring that would cause playback to start back at the beginning when mirroring was stopped.\\n+Fix for Export Bookmarks in settings, backup/export\\n\\nNew Stuff\\n+Interactive Widgets on supported devices\\n+Updated Now Playing view to closer match what the experimental now playing view has had for a long time now.\\n+Support for episode images. Some podcasts add downloadable images for each episode. If the setting is enabled, then those images will be downloaded when starting playback for the selected episode. Settings tab, Appearance, Episode Images from Feed.\\n+Ability to export a playlist (settings) to send to someone else or to send to another device. This doesn't send the contents, just the settings/rules for that playlist.\\n+Export settings to transfer to another app or just to save and restore later.\\n+New option in Settings, playback, general, Max Audio Volume. This is separate from the devices volume. Useful for those that have asked for lower volume\\n+Help tab removed and merged with the settings tab. Settings tab search now includes searching help topics. At least the help topic titles.\\n+Subscribe is not Follow. A change other apps have made some time ago.\\n+Additional app intents available through the shortcuts app for iOS 16.\\n+Added Command+Option+Left and Command+Option+Right shortcuts for skip back and skip forward to work better on the Mac\\n+New playlist published date filter added, Oldest Ready to Play. Podcasts would need to be refreshed for the property to be updated.\\n\\nView the Help tab, Whatâs New to view past updates\\n\\nFollow me on x @joeisanerd and mastodon joeisanerd@techhub.social\",\"releaseDate\":\"2023-10-24\",\"releaseTimestamp\":\"2023-10-24T14:24:13Z\"},{\"versionDisplay\":\"7.6.3\",\"releaseNotes\":\"If you get ongoing value from iCatcher, then please consider the Tip Jar in the help and settings tab or tell your friends about the app. Thank you\\n\\n7.6.3\\nBug Fixes\\n+Fix for the more playback speeds option for the classic now playing view.\\n\\n7.6.2\\nBug Fixes\\n+ Fix for playback speed button in the older now playing\\n+ Fix for stats in settings tab.\\n+ Voice over label correction for the jump back and jump forward amounts\\n+ Fix for text missing on confirm delete episode on the watch\\n\\nView the Help tab, Whatâs New to view past updates\\n\\nFollow me on twitter @joeisanerd\",\"releaseDate\":\"2022-12-10\",\"releaseTimestamp\":\"2022-12-10T21:19:22Z\"}],\"minimumXROSVersion\":\"1.1\",\"isXROSCompatible\":true,\"hasSafariExtension\":false,\"languageList\":[\"InglÃªs\"],\"messagesScreenshots\":{},\"requiresGameController\":false,\"requiredCapabilities\":\"arm64 \",\"offers\":[{\"buyParams\":\"productType=C\u0026price=24900\u0026salableAdamId=414419105\u0026pricingParameters=STDQ\u0026pg=phoenix\u0026appExtVrsId=872243372\",\"type\":\"buy\",\"priceFormatted\":\"R$Â 24,90\",\"price\":24.9,\"priceString\":\"24.90\",\"currencyCode\":\"BRL\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":41057280}]},{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=414419105\u0026pricingParameters=SWUPD\u0026pg=phoenix\u0026appExtVrsId=872243372\",\"type\":\"update\",\"priceFormatted\":\"R$Â 0,00\",\"price\":0,\"priceString\":\"0.00\",\"currencyCode\":\"BRL\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":41057280}]}],\"requires32bit\":false,\"supportedLocales\":[{\"name\":\"InglÃªs\",\"tag\":\"en-US\"}],\"isGameCenterEnabled\":false,\"isSiriSupported\":true,\"releaseDate\":\"2011-03-15\",\"minimumOSVersion\":\"17.4\",\"hasInAppPurchases\":true,\"bundleId\":\"com.joeisanerd.icatcher\",\"hasMessagesExtension\":false,\"supportsGameController\":false,\"artwork\":{\"width\":1024,\"height\":1024,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/6a/7a/95/6a7a955a-da80-e549-7d04-a9c3eef7013f/AppIcon-0-0-1x_U007epad-0-1-0-85-220.png/{w}x{h}{c}.{f}\",\"bgColor\":\"1757ad\",\"textColor1\":\"fbfbfc\",\"textColor2\":\"b1cbef\",\"textColor3\":\"cddaec\",\"textColor4\":\"92b4e2\"},\"privacyPolicyUrl\":\"https://www.joeisanerd.com/privacy\",\"videoPreviewsByType\":{},\"hasFamilyShareableInAppPurchases\":false,\"supportURLForLanguage\":\"https://www.joeisanerd.com/\",\"isHiddenFromSpringboard\":false,\"isSt