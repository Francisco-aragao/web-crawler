050,\"MZ_INDEXER\":1744867267514}}},{\"id\":\"386600664\",\"type\":\"apps\",\"href\":\"/v1/catalog/br/apps/386600664?l=pt-BR\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Dados usados para rastrear vocÃª\",\"identifier\":\"DATA_USED_TO_TRACK_YOU\",\"description\":\"Os seguintes dados podem ser usados para rastrear vocÃª em apps e sites de propriedade de outras empresas:\",\"dataCategories\":[{\"dataCategory\":\"IdentificadoÂ­res\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"InformaÃ§Ãµes de uso\",\"identifier\":\"USAGE_DATA\"}]},{\"privacyType\":\"Dados vinculados a vocÃª\",\"identifier\":\"DATA_LINKED_TO_YOU\",\"description\":\"Os seguintes dados podem ser coletados e vinculados Ã  sua identidade:\",\"dataCategories\":[{\"dataCategory\":\"InformaÃ§Ãµes de uso\",\"identifier\":\"USAGE_DATA\"}]},{\"privacyType\":\"Dados nÃ£o vinculados a vocÃª\",\"identifier\":\"DATA_NOT_LINKED_TO_YOU\",\"description\":\"Os seguintes dados podem ser coletados, mas nÃ£o estÃ£o vinculados Ã  sua identidade:\",\"dataCategories\":[{\"dataCategory\":\"IdentificadoÂ­res\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"InformaÃ§Ãµes de uso\",\"identifier\":\"USAGE_DATA\"},{\"dataCategory\":\"DiagnÃ³stico\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsBrazil\":{\"name\":\"Brazil L\",\"value\":100,\"rank\":6},\"appsApple\":{\"name\":\"+4\",\"value\":100,\"rank\":1}},\"deviceFamilies\":[\"iphone\",\"ipad\",\"ipod\"],\"supportsStreamlinedBuy\":true,\"url\":\"https://apps.apple.com/br/app/podcast-player-rssradio/id386600664\",\"userRating\":{\"value\":4.7,\"ratingCount\":66,\"ratingCountList\":[1,1,1,8,55],\"ariaLabelForRatings\":\"4.7 estrelas\"},\"name\":\"Podcast Player RSSRadio\",\"genreDisplayName\":\"NotÃ­cias\",\"isPreorder\":false,\"isIOSBinaryMacOSCompatible\":true,\"artistName\":\"Dorada App Software Ltd\",\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"ipod\":{\"deviceFamily\":\"iPodÂ touch\",\"requirementString\":\"Requer o iOSÂ 15.6 ou posterior.\"},\"ipad\":{\"deviceFamily\":\"iPad\",\"requirementString\":\"Requer o iPadOSÂ 15.6 ou posterior.\"},\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requer o iOSÂ 15.6 ou posterior.\"},\"mac\":{\"deviceFamily\":\"Mac\",\"requirementString\":\"Requer o macOSÂ 13.0 ou posterior e um Mac com o chip M1 da Apple ou posterior.\"},\"realityDevice\":{\"deviceFamily\":\"Apple Vision\",\"requirementString\":\"Requer o visionOSÂ 1.0 ou posterior.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"13.0\",\"description\":{\"standard\":\"RSSRadio is an advanced Podcast playback app, available on the App Store since 2010. \\n\\nRSSRadio pioneered many features that are commonplace today and continues to evolve.\\n\\nADVANCED\\n\\nâ¢ Silence remover for audio podcasts, saves hours per week for the average listener without affecting sound quality\\nâ¢ Clearer audio with equaliser, compressor / limiter and volume boosting DSP effects (on video, streaming and downloads)\\nâ¢Â Keep multiple devices in Sync with iCloud\\n\\nEFFICIENT\\n\\nâ¢ Organise your listening by categories \\nâ¢ Server side refreshing and push notifications\\nâ¢ RSSRadio is carefully developed and tuned to be nice to your battery\\n\\nFLEXIBLE\\n\\nâ¢ Download or stream any size show over WiFi or 3G\\nâ¢ Fully supports password protected podcasts, including 1Password support\\nâ¢ Built in sleep timer \\nâ¢ Light / Dark UI themes\\nâ¢ Play only the audio part of videos, if you like\\n\\nSMART\\n\\nâ¢ Extensive directory of Podcasts, search for shows by keyword, category, view the top podcasts or enter a URL manually\\nâ¢ Find new shows from RSSRadioâs users listening patterns. RSSRadio can suggest shows you might like based on your existing subscriptions. â¢â¢ your data is anonymous\\n\\nRSSRadio is free, with ads. Try it now.\\n\\nPEOPLE SAY:\\n\\n\\\"RSSRadioÂ® mobile is a very solid offering in the podcast app space. The app is very stable and offers some nice features\\\" - AppAdvice.com \\n\\n\\\"I have found that RSSRadioÂ® is one of the fastest podcasting apps when it comes to managing feeds and downloading episodes. At the moment, no other app has been able to match it when it comes to managing those basic tasks.\\\" - Geoffrey Goetz \\\"Podcasting 101\\\" \\n\\n\\\"RSSRadio7 is the perfect option for a beginning podcaster.\\\" - Emily. C. Gardener / gretchenlouise.com\\n\\nSubscription Information\\n\\nâ¢ Subscription removes the ads \\nâ¢ Subscription is yearly and starts with a one month free trial\\nâ¢ Payment will be charged to iTunes Account at confirmation of purchase\\nâ¢ Subscription automatically renews unless auto-renew is turned off at least 24-hours before the end of the current period\\nâ¢ Your Account will be charged for renewal within 24-hours prior to the end of the current period, and identify the cost of the renewal\\nâ¢ Subscriptions may be managed by you and auto-renewal may be turned off by going to the your Account Settings after purchase\\nâ¢ Any unused portion of a free trial period will be forfeited when you purchase a subscription\\n\\nTerms of Use - http://www.doradasoftware.com/terms\\nPrivacy Policy - http://www.doradasoftware.com/privacy\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"websiteUrl\":\"http://rssrad.io\",\"versionHistory\":[{\"versionDisplay\":\"5.4.33\",\"releaseNotes\":\"â¢ Fix issue validating receipt\",\"releaseDate\":\"2025-04-06\",\"releaseTimestamp\":\"2025-04-06T15:28:52Z\"},{\"versionDisplay\":\"5.4.32\",\"releaseNotes\":\"â¢ This version contains changes to the app and store listing to allow for future developments.\",\"releaseDate\":\"2025-04-05\",\"releaseTimestamp\":\"2025-04-05T15:28:54Z\"},{\"versionDisplay\":\"5.4.31\",\"releaseNotes\":\"T