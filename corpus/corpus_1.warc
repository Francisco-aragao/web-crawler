69792}},\"relationships\":{\"developer\":{\"href\":\"/v1/catalog/br/apps/6465175126/developer?l=pt-BR\",\"data\":[{\"id\":\"1706472738\",\"type\":\"developers\",\"href\":\"/v1/catalog/br/developers/1706472738?l=pt-BR\",\"attributes\":{\"genreNames\":[],\"editorialArtwork\":{},\"name\":\"Daxit Mangukiya\",\"mediaType\":\"Mobile Software Applications\",\"url\":\"https://apps.apple.com/br/developer/daxit-mangukiya/id1706472738\"}}]},\"genres\":{\"href\":\"/v1/catalog/br/apps/6465175126/genres?l=pt-BR\",\"data\":[{\"id\":\"6008\",\"type\":\"genres\",\"href\":\"/v1/catalog/br/genres/6008?l=pt-BR\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Foto e vÃ­deo\",\"url\":\"https://itunes.apple.com/br/genre/id6008\",\"parentId\":\"36\"}}]}},\"meta\":{\"contentVersion\":{\"MZ_INDEXER\":1744788651786,\"RTCI\":1738956843051}}},{\"id\":\"6467128955\",\"type\":\"apps\",\"href\":\"/v1/catalog/br/apps/6467128955?l=pt-BR\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Dados nÃ£o coletados\",\"identifier\":\"DATA_NOT_COLLECTED\",\"description\":\"Os desenvolvedores nÃ£o coletam nenhum dado deste app.\",\"dataCategories\":[]}]},\"contentRatingsBySystem\":{\"appsBrazil\":{\"name\":\"Brazil L\",\"value\":100,\"rank\":6},\"appsApple\":{\"name\":\"+4\",\"value\":100,\"rank\":1}},\"deviceFamilies\":[\"iphone\",\"ipad\",\"ipod\"],\"supportsStreamlinedBuy\":true,\"url\":\"https://apps.apple.com/br/app/face-twist/id6467128955\",\"userRating\":{\"value\":0,\"ratingCount\":0,\"ratingCountList\":[0,0,0,0,0],\"ariaLabelForRatings\":\"0 estrela\"},\"firstVersionSupportingInAppPurchaseApi\":\"1.0\",\"name\":\"Face Twist\",\"genreDisplayName\":\"Foto e vÃ­deo\",\"isPreorder\":false,\"artistName\":\"PROMPTIFY SRL\",\"isIOSBinaryMacOSCompatible\":false,\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"ipod\":{\"deviceFamily\":\"iPodÂ touch\",\"requirementString\":\"Requer o iOSÂ 13.0 ou posterior.\"},\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requer o iOSÂ 13.0 ou posterior.\"},\"ipad\":{\"deviceFamily\":\"iPad\",\"requirementString\":\"Requer o iPadOSÂ 13.0 ou posterior.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"FaceTwist: The Ultimate Face-Swapping Experience!\\n\\nHave you ever wondered how your friend would look in your favorite movie scene? Or imagined swapping faces with a celebrity in a music video? With FaceTwist, dive into a world of endless creativity and fun!\\n\\n Key Features:\\n\\n Seamless Face Swapping: Our advanced algorithm ensures that face swaps look natural, blending perfectly with the original video or image.\\n\\n Video \u0026 Image Support: Whether it's a short clip or a still photo, FaceTwist handles both with precision.\\n\\n High-Quality Outputs: We prioritize quality. Get HD results every time you use FaceTwist.\\n\\n Privacy Guaranteed: Your images and videos are yours alone. We ensure they're processed securely and never stored without permission.\\n\\n Share with the World: With just a tap, share your creations on social media or with friends and family.\\n\\n Creative Freedom: The only limit is your imagination. Create hilarious, impressive, or even surreal content.\\n\\nTerms of Use: https://www.apple.com/legal/internet-services/itunes/dev/stdeula/\\n\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"versionHistory\":[{\"versionDisplay\":\"1.0\",\"releaseNotes\":null,\"releaseDate\":\"2023-11-10\",\"releaseTimestamp\":\"2023-11-10T13:01:42Z\"}],\"websiteUrl\":\"https://promptify.ro/\",\"minimumXROSVersion\":\"1.0\",\"isXROSCompatible\":false,\"hasSafariExtension\":false,\"messagesScreenshots\":{},\"requiresGameController\":false,\"offers\":[{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=6467128955\u0026pricingParameters