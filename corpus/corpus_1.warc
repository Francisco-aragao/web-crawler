13,2\":167489536}},\"relationships\":{\"developer\":{\"href\":\"/v1/catalog/br/apps/1215095006/developer?l=pt-BR\",\"data\":[{\"id\":\"1289801633\",\"type\":\"developers\",\"href\":\"/v1/catalog/br/developers/1289801633?l=pt-BR\",\"attributes\":{\"genreNames\":[],\"editorialArtwork\":{},\"name\":\"Maple Media Apps, LLC\",\"mediaType\":\"Mobile Software Applications\",\"url\":\"https://apps.apple.com/br/developer/maple-media-apps-llc/id1289801633\"}}]},\"genres\":{\"href\":\"/v1/catalog/br/apps/1215095006/genres?l=pt-BR\",\"data\":[{\"id\":\"6009\",\"type\":\"genres\",\"href\":\"/v1/catalog/br/genres/6009?l=pt-BR\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"NotÃ­cias\",\"parentId\":\"36\",\"url\":\"https://itunes.apple.com/br/genre/id6009\"}},{\"id\":\"6007\",\"type\":\"genres\",\"href\":\"/v1/catalog/br/genres/6007?l=pt-BR\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Produtividade\",\"parentId\":\"36\",\"url\":\"https://itunes.apple.com/br/genre/id6007\"}}]}},\"meta\":{\"contentVersion\":{\"RTCI\":1731532874478,\"MZ_INDEXER\":1744806019732}}},{\"id\":\"1080840241\",\"type\":\"apps\",\"href\":\"/v1/catalog/br/apps/1080840241?l=pt-BR\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Dados nÃ£o vinculados a vocÃª\",\"identifier\":\"DATA_NOT_LINKED_TO_YOU\",\"description\":\"Os seguintes dados podem ser coletados, mas nÃ£o estÃ£o vinculados Ã  sua identidade:\",\"dataCategories\":[{\"dataCategory\":\"ConteÃºdo do usuÃ¡rio\",\"identifier\":\"USER_CONTENT\"},{\"dataCategory\":\"IdentificadoÂ­res\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"InformaÃ§Ãµes de uso\",\"identifier\":\"USAGE_DATA\"},{\"dataCategory\":\"DiagnÃ³stico\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsBrazil\":{\"name\":\"Brazil L\",\"value\":100,\"rank\":6},\"appsApple\":{\"name\":\"+4\",\"value\":100,\"rank\":1}},\"deviceFamilies\":[\"watch\",\"iphone\",\"ipod\"],\"chartPositions\":{\"messages\":{\"position\":10,\"genreName\":\"NotÃ­cias\",\"genre\":6009,\"chart\":\"top-free\",\"genreShortName\":\"NotÃ­cias\",\"chartLink\":\"https://apps.apple.com/br/charts/iphone/not%C3%ADcias-apps/6009\"}},\"supportsStreamlinedBuy\":true,\"url\":\"https://apps.apple.com/br/app/podcast-player-app-castro/id1080840241\",\"userRating\":{\"value\":4.6,\"ratingCount\":118,\"ratingCountList\":[6,1,5,14,92],\"ariaLabelForRatings\":\"4.6 estrelas\"},\"firstVersionSupportingInAppPurchaseApi\":\"3.0\",\"watchBundleId\":\"co.supertop.Castro-2.watchkitapp\",\"name\":\"Podcast Player App - Castro\",\"genreDisplayName\":\"NotÃ­cias\",\"isPreorder\":false,\"artistName\":\"Bluck Apps\",\"isIOSBinaryMacOSCompatible\":true,\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"watch\":{\"deviceFamily\":\"AppleÂ Watch\",\"requirementString\":\"Requer o watchOSÂ 8.1 ou posterior.\"},\"ipod\":{\"deviceFamily\":\"iPodÂ touch\",\"requirementString\":\"Requer o iOSÂ 15.0 ou posterior.\"},\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requer o iOSÂ 15.0 ou posterior.\"},\"mac\":{\"deviceFamily\":\"Mac\",\"requirementString\":\"Requer o macOSÂ 12.0 ou posterior e um Mac com o chip M1 da Apple ou posterior.\"},\"realityDevice\":{\"deviceFamily\":\"Apple Vision\",\"requirementString\":\"Requer o visionOSÂ 1.0 ou posterior.\"}},\"minimumWatchOSVersion\":\"8.1\",\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"12.0\",\"description\":{\"standard\":\"Castro is a beautiful, full-featured podcast player that makes it easy to track and manage lots of podcasts at the same time. Only listen to the episodes you want and easily skip the rest, queue up hours of podcasts at a time and enjoy a seamless listening experience with carplay compatibility, chapter support, trim silence and much, much more!\\n\\nHOW IT WORKS\\n\\n1. New episodes land in the NEW tab. Read their descriptions, add episodes you like to your QUEUE, and clear the rest. \\n\\n2. Press play to listen to episodes from your QUEUE in order. Queued episodes are downloaded automatically.\\n\\n3. Re-order your QUEUE to plan your next few hours of listening at any time. Browse your LIBRARY to review the back catalogue, quickly access starred shows, and see your listening history.\\n\\nSubscribing to a podcast is no longer a commitment to listen to every episode. You donât have to manage a huge list of subscriptions or choose a few shows and miss the rest.\\n\\n\\nWHY OUR USERS LOVE CASTRO\\n\\nâ¢ Drag and drop podcasts to plan your listening with Castroâs unique queue\\nâ¢ An elegant dark mode and thoughtfully designed sleep timer offer the best in night time podcast listening.\\nâ¢ CarPlay support makes it easy to pick up where you left off while driving.\\nâ¢ Apple Watch app to control playback and select another episode from your queue.\\nâ¢ Episode notifications include a summary of the episode to help you decide if it interests you. Play, queue or clear the episode directly from the notification without opening the app.\\n\\n\\nCASTRO PLUS\\n\\nCastro Plus is an optional paid subscription available for $24.99/year (includes a one-week trial). Plus unlocks a range of advanced features:\\n\\nâ¢ Trim Silence â With this option on, the app will analyze audio as it plays to detect silent parts and accelerate those parts. Get through more episodes faster.\\nâ¢ Enhance Voices improves the listening experience for many podcasts and makes it easier to hear in loud environments. Under the hood, Enhance Voices applies a dynamic compressor to increase volume just where itâs needed.\\nâ¢ Sideloading: Import audio files directly, just by dropping them in iCloud Drive\\nâ¢ Mono-Mix â Mixes a stereo podcast to mono, which makes it easier to hear podcasts that pan some guests on left/right channels. \\nâ¢ Chapter Support: Artwork, Skipping \u0026 Pre-selection. \\nâ¢ Custom settings per-podcast: Episode Limit, Trim Silence, Enhance Voices, Mono Mix, Skip Intros, Playback Speed.\\n\\n\\nWHAT PEOPLE ARE SAYING\\n\\nâCastro 3 is an incredible app.â\\nâ The Sweet Setup\\n\\nâCastro 3 is everything Castro already was, but better.â\\nâ MacStories\\n\\nCastro 3 Is a Great Modern Podcast Appâ\\nâ Beautiful Pixels\\n\\nâUnlike other podcatchers, Castro's primary virtue is its simplicity and ease of use. The app combines sleek visual design with crystal clear audio.â \\nâ Tomâs Guide\\n\\n\\nCASTRO PLUS SUBSCRIPTION TERMS\\n\\nCastro Plus costs $24.99 per year. Prices are in US dollars and may vary in countries other than the US.\\n\\nCastro Plus is charged to your iTunes Account at confirmation of purchase. It will renew on the day before the current subscription period ends. You can cancel auto-renewal any time from the Castro settings screen.\\n\\nYou can switch between the two subscription periods after you pick one, but your trial period will end immediately if you do, so it's best to wait till your free week is over before changing.\\n\\nSubscription automatically renews unless auto-renew is turned off at least 24-hours before the end of the current period. Your account will be charged for renewal within 24-hours prior to the end of the current period. Subscriptions may be managed by the user and auto-renewal may be turned off by going to the user's Account Settings after purchase. Any unused portion of a free trial period, if offered, will be forfeited when the user purchases a subscription to that publication, where applicable.\\n\\nPrivacy Policy \u0026 Terms of Use: https://castro.fm/privacy-policy\"},\"isStandaloneWithCompanionForWatchOS\":false,\"ovalArtwork\":{\"width\":1024,\"height\":768,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/c3/ad/a1/c3ada170-10e2-0ec4-94a9-1490f29fc935/AppIcon-0-0-1x_U007emarketing-0-85-181.png/{w}x{h}{c}.{f}\",\"bgColor\":\"0dab70\",\"textColor1\":\"101312\",\"textColor2\":\"161616\",\"textColor3\":\"0f3225\",\"textColor4\":\"143428\"},\"isAppleWatchSupported\":true,\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"websiteUrl\":\"https://castro.fm\",\"versionHistory\":[{\"versionDisplay\":\"2025.4.1\",\"releaseNotes\":\"- Total revamp to push notification settings allowing you to easily set a push notification per podcast\\n- Fix a crash when using voiceover related to folder selection\\n- Fix a race condition where search results screen might load forever\\n- Fix some crashes related to queueing items\\n- Remove mini progress bar by popular demand\\n- Improvements to the launch screen and empty view backgrounds\\n- Other crash fixes / UI tweaks\\n\",\"releaseDate\":\"2025-04-09\",\"releaseTimestamp\":\"2025-04-09T17:46:57Z\"},{\"versionDisplay\":\"2025.3.2\",\"releaseNotes\":\"- Explore UI Improvements\\n- Fixed an issue where voiceover wasnât properly reading podcast titles in search \\n- Fix an issue where the queue could be reordered if something goes wrong\\n- Various fixes for deep links and opening the app when it was previously closed\\n- Add progress indicator back to bottom nav\\n- Fixed issues around private feeds with passwords\\n- Redo subscribe/unsubscribing to make them much faster\\n- Improvements and fixes to backup/restore\\n- Fix per podcast playback speed\\n- Better onboarding content\\n- Improvement to queue download hours limit handling and fix various issues where a download might not be deleted\\n- fix a crash when filtering the queue by show or category\\n- Refresh events when activating carplay\",\"releaseDate\":\"2025-04-01\",\"releaseTimestamp\":\"2025-04-01T15:08:32Z\"},{\"versionDisplay\":\"2025.3.1\",\"releaseNotes\":\"Episode Search! Search for a topic or a person and get related episodes in any podcast.\\n\\n- Entirely rewritten search page\\n- Major changes to how the queue works under the hood\\n- Improve background processing so app doesnât load so much at startup\\n- Transcript dialog tweaks\\n- Major improvements to backup/restore to make it more performant\\n- Explore design tweaks\\n- Fix an issue where events might fall behind and get stuck, causing no new episodes to appear\\n- Add published date to accessibility info for episode rows\\n- Fix several crashes\",\"releaseDate\":\"2025-03-20\",\"releaseTimestamp\":\"2025-03-20T16:58:00Z\"},{\"versionDisplay\":\"2025.3\",\"releaseNotes\":\"Episode Search! Search for a topic or a person and get related episodes in any podcast.\\n\\n- Entirely rewritten search page\\n- Major changes to how the queue works under the hood\\n- Improve background processing so app doesnât load so much at startup\\n- Transcript dialog tweaks\\n- Major improvements to backup/restore to make it more performant\\n- Explore design tweaks\\n- Fix an issue where events might fall behind and get stuck, causing no new episodes to appear\\n- Add published date to accessibility info for episode rows\\n- Fix several crashes\\n\",\"releaseDate\":\"2025-03-18\",\"releaseTimestamp\":\"2025-03-18T19:22:19Z\"},{\"versionDisplay\":\"2025.2.1\",\"releaseNotes\":\"- Improved Transcript dialog with search, speaker filters, jump to timestamp, etc\\n- Rewrite event processing to prevent missing episodes, fix crashes, and make everything work better\\n- Fix an issue with the navigation bar title visiblity\\n- Improved OPML export\\n- Fix episode details highlights not always showing up\\n- Improve episode details timestamp identification\\n- Fix random \\\"not authorized\\\" errors that would sometimes occur\\n- Fix an issue with episode actions where watch sync might not show up when it should\\n- Fix empty queue widget to say explore instead of discover\",\"releaseDate\":\"2025-03-08\",\"releaseTimestamp\":\"2025-03-08T00:02:50Z\"},{\"versionDisplay\":\"2025.2\",\"releaseNotes\":\"This release brings our initial podcast:transcript support! See podcast transcripts from creators who put them in their feed. Try \\\"Odd Lots\\\", \\\"Podnews Weekly Review\\\", or \\\"Stuff You Should Know\\\". We're very excited about this, read our blog for more info.\\n\\nOther Changes:\\n- Storage page improvements\\n- Fix an issue where streaming could leak storage space, and fix several related bugs with disk space usage\\n- Fix an issue on explore where it would not let you release your tap if you changed your mind\\n- Minor bug \u0026 crash fixes\",\"releaseDate\":\"2025-02-07\",\"releaseTimestamp\":\"2025-02-07T15:12:43Z\"},{\"versionDisplay\":\"2025.1\",\"releaseNotes\":\"- Sideload fix\\n- Storage page improvements\\n- Fixes some issues where Castro would use too much disk space\\n- Fixes for missing push notifications\",\"releaseDate\":\"2025-01-22\",\"releaseTimestamp\":\"2025-01-22T21:53:22Z\"},{\"versionDisplay\":\"2024.12.1\",\"releaseNotes\":\"- Storage page improvements\\n- Fixes some issues where Castro would use too much disk space\\n- Fixes for missing push notifications\",\"releaseDate\":\"2025-01-16\",\"releaseTimestamp\":\"2025-01-16T19:52:47Z\"},{\"versionDisplay\":\"2024.12\",\"releaseNotes\":\"- Holiday icon and an alternate in red\\n- Skip outros\\n- Storage page for checking your disk space usage\\n- Account Profiles to prepare for device sync\\n- Sideloading fixes\\n- Made some alternate icons free for the holidays\\n- Bug fixes and more\\n\",\"releaseDate\":\"2024-12-24\",\"releaseTimestamp\":\"2024-12-24T00:27:41Z\"},{\"versionDisplay\":\"2024.11.2\",\"releaseNotes\":\"- Fix incorrect season number on episode details in some cases \\n- Make the app more American\\n- Fix up social media links\\n- Bug and crash fixes\\n- App Store stuff\\n\",\"releaseDate\":\"2024-11-21\",\"releaseTimestamp\":\"2024-11-21T21:08:14Z\"},{\"versionDisplay\":\"2024.11.1\",\"releaseNotes\":\"2024.11.1\\n- Fix for icons on older devices\\n\\n2024.11\\n- Sorry, Halloween is over. The pumpkin is no longer the default icon, but you can still get it back in settings for free\\n- Fix an issue in the last release where the timestamps would sometimes not be clickable in episode details\\n- iOS 18.1\\n- Various bug fixes \\n\",\"releaseDate\":\"2024-11-03\",\"releaseTimestamp\":\"2024-11-03T00:19:38Z\"},{\"versionDisplay\":\"2024.11\",\"releaseNotes\":\"- Sorry, Halloween is over. The pumpkin is no longer the default icon, but you can still get it back in settings for free\\n- Fix an issue in the last release where the timestamps would sometimes not be clickable in episode details\\n- iOS 18.1\\n- Various bug fixes \\n- App size improvements\\n\",\"releaseDate\":\"2024-11-01\",\"releaseTimestamp\":\"2024-11-01T17:46:04Z\"},{\"versionDisplay\":\"2024.10.1\",\"releaseNotes\":\"- Pumpkin Icon\\n- More icon choices, including HAL 2.0\\n- Various bug fixes and performance improvements\",\"releaseDate\":\"2024-10-15\",\"releaseTimestamp\":\"2024-10-15T16:57:37Z\"},{\"versionDisplay\":\"2024.9.1\",\"releaseNotes\":\"- New explore category page / icons\\n- Fixes for themes, so parts of the app will no longer be in the wrong dark / light mode\\n- Fix playing all episodes of a podcast from oldest or newest \\n- Crash fixes, including an issue on iOS 18 that would crash the show notes page\\n- Fix various small styling issues:\\n    - Reduce whitespace in show notes\\n    - Fix an issue where message footers in settings could be cut off\\n    - Fix issues with font and background colors in widgets due to accented mode\\n    - Reduce extra padding on episode details page action container when opened from now playing screen\\n    - Make playback speed paywall less confusing\\n\",\"releaseDate\":\"2024-09-25\",\"releaseTimestamp\":\"2024-09-25T18:40:26Z\"},{\"versionDisplay\":\"2024.9\",\"releaseNotes\":\"- New App Icon + revamped Castro plus Icons\\n- iOS 18 support\\n- Explore Section\\n    - Dynamic, automated, recommendations. Grids, lists carousel, podcasts + episodes, charts, categories, etc.\\n    - Support several more countries\\n\\nOther Fixes\\n- Fix an issue where CarPlay next chapter might be disabled\\n- Fix an issue where restoring from backup would fail\\n- Various fixes for the episode details actions\\n- Fix an issue with checking items during onboarding \\n- Many other small UI fixes and tweaks\",\"releaseDate\":\"2024-09-17\",\"releaseTimestamp\":\"2024-09-17T19:08:02Z\"},{\"versionDisplay\":\"2024.8.2\",\"releaseNotes\":\"- Full support for episode artwork from podcast feeds\\n- Fully rewritten episode details page\\n- Fuller actions on episode details so you have full control over your library\\n- Clickable timestamps in show notes\\n- Support for dynamic type in episode details\\n- Season and episode number support\\n- Fix various issues when changing themes throughout the app\\n\",\"releaseDate\":\"2024-09-03\",\"releaseTimestamp\":\"2024-09-03T15:39:37Z\"},{\"versionDisplay\":\"2024.8.1\",\"releaseNotes\":\"- Updates to CarPlay to better handle vehicles without touchscreens\\n- Fix an issue where the widgets would not display if you have too many things in your queue\\n- Fix several issues that would cause episode playback to fail\\n- Crash fixes, etc.\",\"releaseDate\":\"2024-08-20\",\"releaseTimestamp\":\"2024-08-20T22:35:04Z\"},{\"versionDisplay\":\"2024.8\",\"releaseNotes\":\"- New CarPlay app with chapter support\\n- Changes to playback speeds to make them more consistent\\n- Fix an accessibility issue in the inbox where the podcast name would not be read\\n- Fixes for rich content notifications\\n- Fix an issue where the home screen shortcuts would not work\",\"releaseDate\":\"2024-08-12\",\"releaseTimestamp\":\"2024-08-12T14:47:04Z\"},{\"versionDisplay\":\"2024.7\",\"releaseNotes\":\"- Rewrites image artwork, fixing a number of bugs around caching, disk usage, etc\\n- New splash screen\\n- Some experimental changes to playback to hopefully fix issues around echoing or episodes failing to stream\\n- Several crash fixes\\n- This is a foundational release which will allow us to make more significant product changes in the near future\\n\",\"releaseDate\":\"2024-08-06\",\"releaseTimestamp\":\"2024-08-06T11:24:30Z\"},{\"versionDisplay\":\"2024.6\",\"releaseNotes\":\"- Notification summary fix\\n- Lockscreen widget\\n- Playback fixes\",\"releaseDate\":\"2024-07-03\",\"releaseTimestamp\":\"2024-07-03T20:15:32Z\"},{\"versionDisplay\":\"2024.5.1\",\"releaseNotes\":\"- Large interactive widget\\n- Crash fixes\\n- Notification ui\\n- Minor theme issues\\n- Fix issue where backups would fail\\n- Fixes for widgets with text size changes\\n- Onboarding fixes\\n\",\"releaseDate\":\"2024-06-06\",\"releaseTimestamp\":\"2024-06-06T20:15:05Z\"},{\"versionDisplay\":\"2024.5\",\"releaseNotes\":\"- Better notifications\\n- Theme fixes\\n- Accessibility fix for now playing screen\\n- Various under the hood fixes\",\"releaseDate\":\"2024-06-06\",\"releaseTimestamp\":\"2024-06-06T14:46:41Z\"},{\"versionDisplay\":\"2024.4.1\",\"releaseNotes\":\"Castro is under new ownership. Please check our social media and blog for more info. We hope you're enjoying the more frequent updates and server improvements.\\n\\n2024.4\\n- Fixes for certain sideloading links\\n- New medium sized widget\\n- New Castro plus app icons\\n- Several crash fixes\\n- Fixes for widget playback state\\n- Fixes around queuing items sorted by date and related user messaging\\n\\n2024.4.1\\n- Additional crash fixes and widget fixes\",\"releaseDate\":\"2024-04-30\",\"releaseTimestamp\":\"2024-04-30T20:08:06Z\"},{\"versionDisplay\":\"2024.4\",\"releaseNotes\":\"Castro is under new ownership. Please check our social media and blog for more info. We hope you're enjoying the more frequent updates and server improvements.\\n\\nThis update contains:\\n- Fixes for certain sideloading links\\n- New medium sized widget\\n- New Castro plus app icons\\n- Several crash fixes\\n- Fixes for widget playback state\\n- Fixes around queuing items sorted by date and related user messaging\",\"releaseDate\":\"2024-04-28\",\"releaseTimestamp\":\"2024-04-28T17:23:16Z\"},{\"versionDisplay\":\"2024.3\",\"releaseNotes\":\"â¢\\tFixes for light/dark mode issues when the app wasnât sure what theme it was on\\nâ¢\\tFixes for minute/hour calculations\\nâ¢\\tFixes for various visual issues around Castro Plus, text rendering, icon showing up randomly for plus users\\nâ¢\\tPlayback author / Podcast name fix on notification\\nâ¢\\tFixes shortcut domain\\nâ¢\\tAdds an interactive widget\\nâ¢\\tVisual fixes for the queue widgets\\nâ¢\\tFix for sideloading bug where new files would not be recognized\\nâ¢\\tFix for sideloading bug where youtube videos would download very slowly\\nâ¢\\tAdd button to clear the queue\\nâ¢\\tAdd ability to mark as played manually\",\"releaseDate\":\"2024-04-07\",\"releaseTimestamp\":\"2024-04-07T14:38:16Z\"}],\"isXROSCompatible\":true,\"minimumXROSVersion\":\"1.0\",\"hasSafariExtension\":false,\"messagesScreenshots\":{\"iphone_6_5\":[{\"width\":1242,\"height\":2688,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/ac/8a/6b/ac8a6b64-a9c7-52b1-40bc-48bddc9b9300/mzl.omerrbaa.png/{w}x{h}{c}.{f}\",\"bgColor\":\"f0f0f0\",\"textColor1\":\"050505\",\"textColor2\":\"2c2c2c\",\"textColor3\":\"343434\",\"textColor4\":\"535353\"}],\"iphone6+\":[{\"width\":1242,\"height\":2208,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/aa/5f/f0/aa5ff0c6-be76-65e0-f839-270ddef2e475/mzl.mohohayu.png/{w}x{h}{c}.{f}\",\"bgColor\":\"f9f9f9\",\"textColor1\":\"120b07\",\"textColor2\":\"262422\",\"textColor3\":\"403a37\",\"textColor4\":\"504e4d\"},{\"width\":1242,\"height\":2208,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/13/1a/f7/131af745-e8dd-2c35-b5f1-3ed73ca64f89/mzl.dvestplc.png/{w}x{h}{c}.{f}\",\"bgColor\":\"f9f9f9\",\"textColor1\":\"161616\",\"textColor2\":\"3a0307\",\"textColor3\":\"434343\",\"textColor4\":\"603437\"},{\"width\":1242,\"height\":2208,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/a9/89/43/a98943c5-fe00-b9c9-1415-c7d498b8a2ca/mzl.ydyyadlb.png/{w}x{h}{c}.{f}\",\"bgColor\":\