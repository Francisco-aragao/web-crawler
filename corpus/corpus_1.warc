es/6001?l=pt-BR\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"PrevisÃ£o do tempo\",\"parentId\":\"36\",\"url\":\"https://itunes.apple.com/br/genre/id6001\"}}]},\"developer\":{\"href\":\"/v1/catalog/br/apps/1629921985/developer?l=pt-BR\",\"data\":[{\"id\":\"974193499\",\"type\":\"developers\",\"href\":\"/v1/catalog/br/developers/974193499?l=pt-BR\",\"attributes\":{\"genreNames\":[],\"editorialArtwork\":{},\"name\":\"Cascable AB\",\"mediaType\":\"Mobile Software Applications\",\"url\":\"https://apps.apple.com/br/developer/cascable-ab/id974193499\"}}]}},\"meta\":{\"contentVersion\":{\"MZ_INDEXER\":1744837414141,\"RTCI\":1744773797572}}},{\"id\":\"1522019394\",\"type\":\"apps\",\"href\":\"/v1/catalog/br/apps/1522019394?l=pt-BR\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Dados nÃ£o coletados\",\"identifier\":\"DATA_NOT_COLLECTED\",\"description\":\"Os desenvolvedores nÃ£o coletam nenhum dado deste app.\",\"dataCategories\":[]}]},\"contentRatingsBySystem\":{\"appsBrazil\":{\"name\":\"Brazil L\",\"value\":100,\"rank\":6},\"appsApple\":{\"name\":\"+4\",\"value\":100,\"rank\":1}},\"deviceFamilies\":[\"iphone\",\"ipad\",\"ipod\"],\"supportsStreamlinedBuy\":true,\"url\":\"https://apps.apple.com/br/app/elinchrom/id1522019394\",\"userRating\":{\"value\":0,\"ratingCount\":0,\"ratingCountList\":[0,0,0,0,0],\"ariaLabelForRatings\":\"0 estrela\"},\"genreDisplayName\":\"Foto e vÃ­deo\",\"name\":\"Elinchrom\",\"isPreorder\":false,\"isIOSBinaryMacOSCompatible\":false,\"artistName\":\"ELINCHROM LTD\",\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"ipad\":{\"deviceFamily\":\"iPad\",\"requirementString\":\"Requer o iPadOSÂ 11.1 ou posterior.\"},\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requer o iOSÂ 11.1 ou posterior.\"},\"ipod\":{\"deviceFamily\":\"iPodÂ touch\",\"requirementString\":\"Requer o iOSÂ 11.1 ou posterior.\"},\"realityDevice\":{\"deviceFamily\":\"Apple Vision\",\"requirementString\":\"Requer o visionOSÂ 1.0 ou posterior.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"Simplify your workflow by controlling enabled Elinchrom units from your iPhone with the Elinchrom App and the Elinchrom Bridge module.\\n\\nKeep an overview of your lighting setup from your iPhone and quickly access each unitsâ most important settings even when they are out of reach. Any custom setup can be saved and reloaded when needed, saving you time for your next shoot.\\n \\nUser-friendly name, signal strength, stand-by mode, firmware indicator, and many more options are available to fine-tune your Setup.\\n \\nThe Elinchrom Bridge module is necessary to make the Elinchrom App function.\\nMore information about the Elinchrom Bridge:\\nhttps://www.elinchrom.com/skyport/studio-software.html\\n \\nFeatures:\\nâ¢ Control up to 20 Units\\nâ¢ Control individually or simultaneously (power, modelling lamp, sound, etc.)\\nâ¢ 20 Frequencies available\\nâ¢ 4 Groups with dedicated colors\\nâ¢ Change unit group by drag and drop\\nâ¢ User-friendly name\\nâ¢ Save all unit settings and reload them when required\\nâ¢ Signal strength indication\\nâ¢ Firmware indicator to inform if a new update is available\\n \\nElinchrom unit compatibility:\\nâ¢ ELC 125/500\\nâ¢ ELC Pro HD 500/1000\\nâ¢ ELB 400\\nâ¢ ELB 500 TTL\\nâ¢ ELB 1200\\nâ¢ ELM8\\nâ¢ D-Lite RX One/2/4*\\nâ¢ BRX 250/500*\\n\\n*User-friendly name not available\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 bluetooth-le \",\"versionHistory\":[{\"versionDisplay\":\"1.0.5\",\"releaseNotes\":\"Support for new products\\nUpdated web links\\n\",\"releaseDate\":\"2022-05-05\",\"releaseTimestamp\":\"2022-05-05T14:04:34Z\"},{\"versionDisplay\":\"1.0.4\",\"releaseNotes\":\"Support for new products\",\"releaseDate\":\"2021-0