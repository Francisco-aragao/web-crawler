viceFamilies\":[\"iphone\",\"ipad\"],\"supportsStreamlinedBuy\":true,\"url\":\"https://apps.apple.com/br/app/lysten-podcast-player/id1579212581\",\"userRating\":{\"value\":0,\"ratingCount\":0,\"ratingCountList\":[0,0,0,0,0],\"ariaLabelForRatings\":\"0 estrela\"},\"firstVersionSupportingInAppPurchaseApi\":\"1.3.0\",\"name\":\"Lysten: Podcast Player\",\"genreDisplayName\":\"NotÃ­cias\",\"isPreorder\":false,\"isIOSBinaryMacOSCompatible\":false,\"artistName\":\"Ambi Studio AB\",\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"ipad\":{\"deviceFamily\":\"iPad\",\"requirementString\":\"Requer o iPadOSÂ 17.0 ou posterior.\"},\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requer o iOSÂ 17.0 ou posterior.\"},\"realityDevice\":{\"deviceFamily\":\"Apple Vision\",\"requirementString\":\"Requer o visionOSÂ 1.0 ou posterior.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"14.0\",\"description\":{\"standard\":\"With no registration or complex settings, you can start listening right away with a simple search. Follow your favorite shows and automatically get a list of episodes to listen to.\\n\\nShare episodes and shows with anyone, irregardless if they have the app downloaded or not. Any iPhone and iPad user will get an AppClip to get them started listening right away. Tap the share button to invite your friends and loved ones.\\n\\nLysten is a light-weight and privacy focused Podcast Player. Your followed Podcasts and Episode progress are synced using your private iCloud account. This means that there's simply no way for us to see what you follow, listen to or anything else you might do in our app. We do collect crash reports do make sure the app is as stable as possible, but these reports are anonymous and can't be tracked back to you.\\n\\nFeatures:\\n- Interactive widgets showing your feed and unfinished episodes. Catch up where you left off with a tap.\\n- Download episodes to listen offline, long press an episode and select Download.\\n- No registration, sync is made using your iCloud account\\n- Extremely lightweight\\n- Sleep timer, set, enjoy \u0026 sleep\\n- Play speed, adjust the play rate to your preference\\n- Podcasts and Episodes are indexed in Spotlight\\n- SharePlay support, listen to episodes with friends and family\\n- Privacy focused\\n- Written in 100% SwiftUI\\n\\n\\nIf you run into any trouble you can reach out to us at support@ambi.se or on Mastodon:\\n\\nPrivacy policy: https://ambi.se/privacy\\nTerms of use: https://ambi.se/terms\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"versionHistory\":[{\"versionDisplay\":\"1.7.4\",\"releaseNotes\":\"- Improves RSS feed refresh functionality\\n- Fixes a bug where some episodes only appears after restart in feed\\n- Fixes bug where episodes could appear in two columns on iPhone in portrait mode\\n- When executing Pull To Refresh, the loading indicator now stays visible until refresh finishes\\n- Fixes crash occurring when saving creates a deadlock\\n- Fixes crash that could occur when audio category couldn't be set\\n\",\"releaseDate\":\"2025-01-20\",\"releaseTimestamp\":\"2025-01-20T10:49:53Z\"},{\"versionDisplay\":\"1.7.3\",\"releaseNotes\":\"- From now on episodes can only be downloaded from followed podcasts\\n- Hide / Show finished episodes in the Podcasts tab is now saved accross app restarts\\n- Player minimizes if you tap podcast name in full screen player\\n\",\"releaseDate\":\"2024-12-08\",\"releaseTimestamp\":\"2024-12-08T20:29:35Z\"},{\"versionDisplay\":\"1.7.2\",\"releaseNotes\":\"- Fixes bug where podcasts with incorrect pubdate couldn't be parsed\\n\",\"releaseDate\":\"2024-07-27\",\"releaseTimestamp\":\"2024-07-27T09:32:18Z\"},{\"versionDisplay\":\"1.7.1\",\"releaseNotes\":\"- Fixes crash that could occur while playing episodes on a poor connection\\n- Fixes rare bug where opening a podcast could crash the app\\n- Fixes bug where downloaded episodes could disappear\\n\",\"releaseDate\":\"2024-06-05\",\"releaseTimestamp\":\"2024-06-05T18:06:12Z\"},{\"versionDisplay\":\"1.7.0\",\"releaseNotes\":\"- Adds \\\"Continue\\\" carousel, making it super easy to pick up where you left off.\\n- Episodes tab is now named Feed. Should also fix an issue where episodes didn't always appear.\\n- Adds crash reporting, this will help us squish the last few bugs.\\n\",\"releaseDate\":\"2024-05-29\",\"releaseTimestamp\":\"2024-05-29T19:54:19Z\"},{\"versionDisplay\":\"1.6.1\",\"releaseNotes\":\"- Fixes bug where share button in player created an invalid URL\\n\",\"releaseDate\":\"2024-05-23\",\"releaseTimestamp\":\"2024-05-23T00:03:46Z\"},{\"versionDisplay\":\"1.6.0\",\"releaseNotes\":\"- Adds background to scrub popover\\n- Adds Marquee to player, meaning long titles will nog scroll by smoothly\\n- Fixes a bug where episode sharing was broken\\n- Fixes main thread freeze on interactive RSS refresh\\n- Fixes so player no longer covers tab and nav bar\\n- Design fixes to small, large and full screen players\",\"releaseDate\":\"2024-04-28\",\"releaseTimestamp\":\"2024-04-28T14:32:26Z\"},{\"versionDisplay\":\"1.5.2\",\"releaseNotes\":\"This update a bug that could make the app crash on start.\",\"releaseDate\":\"2023-12-19\",\"releaseTimestamp\":\"2023-12-19T12:48:25Z\"},{\"versionDisplay\":\"1.5.1\",\"releaseNotes\":\"Hej,\\n\\nThis update fixes a bug that could make Lysten crash when playing an episode.\",\"releaseDate\":\"2023-10-22\",\"releaseTimestamp\":\"2023-10-22T11:16:17Z\"},{\"versionDisplay\":\"1.5.0\",\"releaseNotes\":\"Hej,\\n\\nThis update adds the following:\\n\\n- Downloads; Long press an episode and select Download\\n- Adds interactive widgets. There are two types, either it shows your feed or the latest episodes you listened to but didn't finish.\\n- Adds support to change sort order in Podcast view\\n- Adds support to only show downloaded episodes\",\"releaseDate\":\"2023-10-06\",\"releaseTimestamp\":\"2023-10-06T16:57:26Z\"},{\"versionDisplay\":\"1.4.0\",\"releaseNotes\":\"This update brings both fixes bugs and introduces some new fancy features. Here's what's new:\\n\\n- Fixes so the player no longer covers tab bar or navigation bar\\n- Makes sure loading indicator isn't shown while playing episode\\n- Adds SharePlay support\\n- Adds SharePlay button to episode detail view\\n- Adds a link to the show view in the episode detail view\\n- Fixes bug where the cover art didn't always instantly update when changing episode\\n- Minor bug fixes\",\"releaseDate\":\"2023-05-23\",\"releaseTimestamp\":\"2023-05-23T17:31:59Z\"},{\"versionDisplay\":\"1.3.1\",\"releaseNotes\":\"Fixes a bug where some users were unable to restore purchases\",\"releaseDate\":\"2023-03-15\",\"releaseTimestamp\":\"2023-03-15T15:59:25Z\"},{\"versionDisplay\":\"1.3.0\",\"releaseNotes\":\"Hej,\\n\\nThis update has a ton of stuff, you better get comfortable before you try to read these release notes.\\n\\nFeatures:\\n- Player speed can now be adjusted to your preference\\n- Sleep timer can now be set\\n- When playing an episode we automatically queue the next 20 episodes too. More is always better, right?\\n- Episode detail can now be opened directly from the player\\n- Adds a paywall\\n\\nFixes:\\n- The player could occasionally fade in and out, this should now be fixed\\n- Fixes a bug where the moving bars in a playing episode could sometimes act weird\\n- Adds lysten: scheme that opens app, fallback if universal linking fails\\n- Fixes a bug where the share-button could sometimes bounce around\\n\\nThanks for using Lysten!\\n\\n/ Sofia \u0026 CÃ©sar\",\"releaseDate\":\"2023-03-14\",\"releaseTimestamp\":\"2023-03-14T23:51:20Z\"},{\"versionDisplay\":\"1.2.0\",\"releaseNotes\":\"This update has a ton of changes, here is the most important details\\n\\n- An episode detail view has been added. This is where you find show notes.\\n- Progress sync has been improved. It will now sync faster and consume less space on your iCloud\\n- Code for refreshing RSS-feeds has been improved, consuming less power and giving a better user experience\\n- Fixes a bug where episode count sometimes was wrong in podcast detail view\\n- Fixes one of the crashes that occurred when Lysten was in the background\\n- You can now stop the player, hold your finger on it and select Stop\\n\\nThanks for using Lysten!\\n\\n/CÃ©sar \u0026 Sofia\",\"releaseDate\":\"2023-03-09\",\"releaseTimestamp\":\"2023-03-09T20:36:46Z\"},{\"versionDisplay\":\"1.1.1\",\"releaseNotes\":\"Fixes a crash that occurs when the app is in the background\",\"releaseDate\":\"2023-02-24\",\"releaseTimestamp\":\"2023-02-24T09:32:29Z\"},{\"versionDisplay\":\"1.1.0\",\"releaseNotes\":\"- Adds AppClip support. You can now share Podcasts \u0026 Episodes with other users. If they have an iPhone or iPad Lysten will be installed and the linked content will be shown. Pretty cool!\\n- Share buttons have been added in context menus, podcast view and in the player\\n- We removed the fullscreen player, the player is now always \\\"floating\\\" and can be moved around\\n- Easier to search and find podcasts in the new search view\\n- You now follow podcasts from the Podcast detail view. We think this makes it much more intuitive.\\n- You can now import your shows from other Podcast apps. Simply export an XML / OPML file and share it with Lysten.\\n- Improves performance by downscaling images and caching them locally\\n- Fixes a weird bug where we only showd 2 episodes in \\\"The Talk Show\\\" by John Gruber. Sorry John. If you happen to read this, ping us on mastodon and we'll get you a beer.\\n- Makes the podcast name selectable in the large player\\n\\nThanks for taking the time to read our release notes! Please consider leaving an App Store review while you're here :)\",\"releaseDate\":\"2023-02-12\",\"releaseTimestamp\":\"2023-02-12T01:41:18Z\"},{\"versionDisplay\":\"1.0.0\",\"releaseNotes\":null,\"releaseDate\":\"2023-01-17\",\"releaseTimestamp\":\"2023-01-17T22:55:45Z\"}],\"isXROSCompatible\":true,\"minimumXROSVersion\":\"1.0\",\"hasSafariExtension\":false,\"messagesScreenshots\":{},\"requiresGameController\":false,\"offers\":[{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1579212581\u0026pricingParameters=STDQ\u0026pg=phoenix\u0026appExtVrsId=871699164\",\"type\":\"get\",\"priceFormatted\":\"R$Â 0,00\",\"price\":0,\"priceString\":\"0.00\",\"currencyCode\":\"BRL\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":21945344}]},{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1579212581\u0026pricingParameters=SWUPD\u0026pg=phoenix\u0026appExtVrsId=871699164\",\"type\":\"update\",\"priceFormatted\":\"R$Â 0,00\",\"price\":0,\"priceString\":\"0.00\",\"currencyCode\":\"BRL\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":21945344}]}],\"requires32bit\":false,\"releaseDate\":\"2023-01-17\",\"hasInAppPurchases\":true,\"bundleId\":\"se.ambi.podcast\",\"hasMessagesExtension\":false,\"artwork\":{\"width\":1024,\"height\":1024,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/a5/92/3f/a5923ffa-dd59-f70f-99a5-529ae81ef441/AppIcon-0-1x_U007epad-0-1-P3-85-220-0.png/{w}x{h}{c}.{f}\",\"bgColor\":\"5c00a0\",\"textColor1\":\"d8bdec\",\"textColor2\":\"c7a3e5\",\"textColor3\":\"bf97dc\",\"textColor4\":\"b182d7\"},\"privacyPolicyUrl\":\"https://ambi.se/privacy\",\"videoPreviewsByType\":{},\"isHiddenFromSpringboard\":false,\"isStandaloneForWatchOS\":false,\"supportURLForLanguage\":\"https://ambi.se\",\"isDeliveredInIOSAppForWatchOS\":false,\"editorialArtwork\":{\"contentIconTrimmedMonochrome\":{\"width\":990,\"height\":1080,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features126/v4/9b/2f/2c/9b2f2c8d-7f71-4b3d-b3f3-c095e9bdc1b5/bdb47b8f-9739-48e1-b674-ea7060cb7ac9.png/{w}x{h}{c}.{f}\",\"bgColor\":\"000000\",\"textColor1\":\"f2f2f2\",\"textColor2\":\"e5e5e5\",\"textColor3\":\"c1c1c1\",\"textColor4\":\"b7b7b7\"},\"contentIconTrimmed\":{\"width\":990,\"height\":1080