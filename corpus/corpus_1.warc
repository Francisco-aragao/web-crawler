abled\":false,\"name\":\"50 CrÃ©ditos\",\"description\":{\"standard\":\"Pacote PadrÃ£o\"},\"icuLocale\":\"pt_BR@currency=BRL\",\"url\":\"https://apps.apple.com/br/app/50-cr%C3%A9ditos/id6480458740\"}}]},\"developer-other-apps\":{\"href\":\"/v1/catalog/br/apps/6480458740/developer-other-apps?l=pt-BR\",\"data\":[{\"id\":\"6504253272\",\"type\":\"apps\",\"href\":\"/v1/catalog/br/apps/6504253272?l=pt-BR\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Dados nÃ£o coletados\",\"identifier\":\"DATA_NOT_COLLECTED\",\"description\":\"Os desenvolvedores nÃ£o coletam nenhum dado deste app.\",\"dataCategories\":[]}]},\"contentRatingsBySystem\":{\"appsBrazil\":{\"name\":\"Brazil 12\",\"value\":300,\"rank\":8,\"advisories\":[\"ConteÃºdo sexual e nudez infrequente/moderado\",\"Temas adultos/sugestivos infrequentes/moderados\"]},\"appsApple\":{\"name\":\"+12\",\"value\":300,\"rank\":3,\"advisories\":[\"ConteÃºdo sexual e nudez infrequente/moderado\",\"Temas adultos/sugestivos infrequentes/moderados\"]}},\"deviceFamilies\":[\"iphone\"],\"supportsStreamlinedBuy\":true,\"url\":\"https://apps.apple.com/br/app/promptface-ai-headshots/id6504253272\",\"userRating\":{\"value\":0,\"ratingCount\":0,\"ratingCountList\":[0,0,0,0,0],\"ariaLabelForRatings\":\"0 estrela\"},\"name\":\"PromptFace AI Headshots\",\"genreDisplayName\":\"Foto e vÃ­deo\",\"isPreorder\":false,\"isIOSBinaryMacOSCompatible\":true,\"artistName\":\"Elgun Huseynli\",\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requer o iOSÂ 17.0 ou posterior.\"},\"mac\":{\"deviceFamily\":\"Mac\",\"requirementString\":\"Requer o macOSÂ 14.4 ou posterior e um Mac com o chip M1 da Apple ou posterior.\"},\"realityDevice\":{\"deviceFamily\":\"Apple Vision\",\"requirementString\":\"Requer o visionOSÂ 1.0 ou posterior.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"14.4\",\"description\":{\"standard\":\"Welcome to PromptFace AI, Your Face, Your Story, Brought to Life!\\n\\nUnleash your creativity and transform your selfies into stunning AI-generated art with PromptFace AI! This revolutionary photo generator app blends face swap and deepfake technology with the power of words to create personalized masterpieces.\\n\\nKey Features:\\n\\n- Prompt-Powered Transformations: Describe your vision with a custom prompt or choose from a variety of template prompts to guide the AI's artistic interpretation.\\n- Face Swap Magic: Seamlessly insert your face into different scenarios, characters, and settings.\\n- Deepfake Artistry: Witness your likeness come alive in unexpected ways as the AI reimagines you in various styles.\\n- Endless Possibilities: Explore a wide range of styles, from classic paintings to modern digital art. Become a superhero, a mythical creature, or even a character from your favorite movie!\\n- Easy-to-Use Interface: Simply upload your photo, select your prompt, and watch as the AI works its magic.\\n- High-Quality Results: Get stunning, high-resolution images ready to share with friends and family.\\n- Regular Updates: Enjoy new prompts, styles, and features as we continue to improve the app.\\n\\nUnleash Your Inner Artist:\\n\\nWhether you're a seasoned artist or just looking for a fun way to express yourself, PromptFace AI makes it easy to create unique and captivating art that's all your own.\\n\\nShare Your Creations:\\n\\nShow off your one-of-a-kind art on social media, use it as a profile picture, or print it out to display at home.  The possibilities are endless!\\n\\nDownload PromptFace AI today and start creating stunning AI-generated art with your face!\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"versionHistory\":[{\"versionDisplay\":\"1.1\",\"releaseNotes\":\"Performance optimizations.\",\"releas