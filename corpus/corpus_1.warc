ting\":{\"value\":4.2,\"ratingCount\":5,\"ratingCountList\":[1,0,0,0,4],\"ariaLabelForRatings\":\"4.2 estrelas\"},\"firstVersionSupportingInAppPurchaseApi\":\"1.0.0\",\"name\":\"Face Swap Video: Deep Fake\",\"genreDisplayName\":\"Foto e vÃ­deo\",\"isPreorder\":false,\"isIOSBinaryMacOSCompatible\":true,\"artistName\":\"MUHAMMET EMIN CORTUL\",\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"ipod\":{\"deviceFamily\":\"iPodÂ touch\",\"requirementString\":\"Requer o iOSÂ 13.0 ou posterior.\"},\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requer o iOSÂ 13.0 ou posterior.\"},\"ipad\":{\"deviceFamily\":\"iPad\",\"requirementString\":\"Requer o iPadOSÂ 13.0 ou posterior.\"},\"mac\":{\"deviceFamily\":\"Mac\",\"requirementString\":\"Requer o macOSÂ 11.0 ou posterior e um Mac com o chip M1 da Apple ou posterior.\"},\"realityDevice\":{\"deviceFamily\":\"Apple Vision\",\"requirementString\":\"Requer o visionOSÂ 1.0 ou posterior.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"Face Swap - AI-Powered Face Swapping Made Easy!\\n\\nTransform your videos with Face Swap, the ultimate app for creating fun and realistic face-swapped videos. Choose from a variety of ready-made templates or upload your own videos to seamlessly swap faces with advanced AI technology.\\n\\nFeatures:\\n\\nReady-Made Templates: Select from a vast collection of trending videos and effortlessly swap faces.\\nUpload Your Own Videos: Personalize your content by using your own videos for face swapping.\\nEasy to Use: Simply choose a video, select your face, and let the app do the rest.\\nShare with Friends: Instantly share your hilarious creations on Instagram, TikTok, WhatsApp, and more.\\nExperience the magic of AI face swapping with Face Swap. Download now and start having fun!\\n\\n\\nPrivacy Policy: https://denizme.github.io/deepfake-privacy-policy.html\\nTerms and Conditions: https://denizme.github.io/deepfake-terms-of-use.ht